diff --git a/test/retry.test.ts b/test/retry.test.ts
index 253bb41..7f9c5f5 100644
--- a/test/retry.test.ts
+++ b/test/retry.test.ts
@@ -1,7 +1,21 @@
-import { expect, it } from 'vitest'
+import { expect, it, vi } from 'vitest'
 
 import { retry } from '../src/retry'
 
 it('returns the result', async () => {
   await expect(retry(async () => 42)).resolves.toBe(42)
 })
+
+it('retries a rejected task', async () => {
+  let task = vi.fn()
+    .mockRejectedValueOnce(new Error('first'))
+    .mockResolvedValueOnce('second')
+  await expect(retry(task)).resolves.toBe('second')
+  expect(task).toHaveBeenCalledTimes(2)
+})
+
+it('gives up after 3 attempts with the last error', async () => {
+  let task = vi.fn().mockRejectedValue(new Error('down'))
+  await expect(retry(task)).rejects.toMatchObject({ message: 'down' })
+  expect(task).toHaveBeenCalledTimes(3)
+})
