+import path from 'node:path'
+
+import { DRY_SNAPSHOT_VERSION } from './dry-snapshot-version'
+
+/**
+ * Builds the path of the dry run snapshot of a project (`DrySnapshot`), next
+ * to the cache file.
+ *
+ * @param root - Project root.
+ * @returns Absolute path, such as
+ *   `<root>/node_modules/.cache/mootant/dry-v1.json`.
+ */
+export function getDrySnapshotPath(root: string): string {
+  return path.join(
+    root,
+    'node_modules',
+    '.cache',
+    'mootant',
+    `dry-v${DRY_SNAPSHOT_VERSION}.json`,
+  )
+}
diff --git a/core/cache/hash-project-tree.ts b/core/cache/hash-project-tree.ts
new file mode 100644
index 0000000..b5ac139
--- /dev/null
+++ b/core/cache/hash-project-tree.ts
@@ -0,0 +1,60 @@
+import { readlink, readdir } from 'node:fs/promises'
+import path from 'node:path'
+
+import { compareCodeUnits } from '../compare-code-units'
+import { getPortablePath } from './get-portable-path'
+import { createDigest } from './create-digest'
+import { hashFiles } from './hash-files'
+
+/**
+ * Directories the hash of a project tree leaves out, at any depth: installed
+ * packages, whose changes the lockfile stands for, git's own files, and the
+ * reports mootant writes.
+ */
+const SKIPPED = new Set(['node_modules', '.mootant', '.git'])
+
+/**
+ * Hashes every file under the project root with its contents, so that adding,
+ * removing, renaming or changing any file changes the hash: a new test file, a
+ * test file the dry run did not run that now imports a mutated file, or a file
+ * that now shadows a module a test imports. Directories in `SKIPPED` are left
+ * out; a symbolic link counts by its target, never followed.
+ *
+ * @param root - Directory whose files are hashed: the project root.
+ * @returns SHA-256 in hex of the sorted portable paths and their hashes.
+ */
+export async function hashProjectTree(root: string): Promise<string> {
+  let files: string[] = []
+  let links: [string, string][] = []
+  /**
+   * Lists the files of a directory and of the directories in it.
+   *
+   * @param directory - Absolute path of the directory.
+   * @returns Resolves when the directory is listed.
+   */
+  async function walk(directory: string): Promise<void> {
+    let entries = await readdir(directory, { withFileTypes: true })
+    await Promise.all(
+      entries.map(async entry => {
+        let file = path.join(directory, entry.name)
+        if (entry.isSymbolicLink()) {
+          links.push([getPortablePath(file, root), await readlink(file)])
+        } else if (entry.isDirectory()) {
+          if (!SKIPPED.has(entry.name)) {
+            await walk(file)
+          }
+        } else {
+          files.push(file)
+        }
+      }),
+    )
+  }
+  await walk(root)
+  let hashes = await hashFiles(files)
+  return createDigest({
+    files: files
+      .map(file => [getPortablePath(file, root), hashes.get(file) ?? null])
+      .toSorted(([left], [right]) => compareCodeUnits(left!, right!)),
+    links: links.toSorted(([left], [right]) => compareCodeUnits(left, right)),
+  })
+}
diff --git a/core/cache/list-variable-hashes.ts b/core/cache/list-variable-hashes.ts
new file mode 100644
index 0000000..d6ae53d
--- /dev/null
+++ b/core/cache/list-variable-hashes.ts
@@ -0,0 +1,76 @@
+import { createHash } from 'node:crypto'
+
+import { compareCodeUnits } from '../compare-code-units'
+import { createDigest } from './create-digest'
+
+/**
+ * Variables that change verdicts whatever reads them (dates, collation, the
+ * mode libraries pick up, Node's own flags); the adapters key their settings on
+ * the same ones.
+ */
+const VERDICT_VARIABLES = /^(?:LANG|NODE_ENV|NODE_OPTIONS|LC_.+|TZ)$/u
+
+/**
+ * Variables that change from one shell to another and are left out of `*`, as
+ * the adapters leave them out of theirs (`indexEnvironmentHashes`).
+ */
+const VOLATILE = new Set([
+  'ITERM_SESSION_ID',
+  'TERM_SESSION_ID',
+  'WINDOWID',
+  'OLDPWD',
+  'SHLVL',
+  'PWD',
+  '_',
+])
+
+/**
+ * Hashes the values of environment variables of the main process for a dry run
+ * snapshot (`DrySnapshot.variables`): the given names, which test files read,
+ * and every variable that changes verdicts whatever reads it, set or not. The
+ * name `*`, for test files that listed every variable, stands for a hash of
+ * every variable but the volatile ones, so adding, removing or changing any of
+ * them changes it.
+ *
+ * @param names - Names the test files read, `*` included.
+ * @param environment - Environment variables of the main process.
+ * @returns Name and SHA-256 in hex of each value, or null when unset, by name.
+ */
+export function listVariableHashes(
+  names: Iterable<string>,
+  environment: NodeJS.ProcessEnv = process.env,
+): [string, string | null][] {
+  let all = new Set(names)
+  for (let name of Object.keys(environment)) {
+    if (VERDICT_VARIABLES.test(name)) {
+      all.add(name)
+    }
+  }
+  all.add('NODE_OPTIONS')
+  return [...all].toSorted(compareCodeUnits).map(name => {
+    if (name === '*') {
+      return [
+        name,
+        createDigest(
+          Object.keys(environment)
+            .filter(key => !VOLATILE.has(key))
+            .toSorted(compareCodeUnits)
+            .map(key => [key, hashValue(environment[key])]),
+        ),
+      ]
+    }
+    return [name, hashValue(environment[name])]
+  })
+}
+
+/**
+ * Hashes the value of one variable.
+ *
+ * @param value - Value, or undefined when unset.
+ * @returns SHA-256 in hex, or null when unset.
+ */
+function hashValue(value: undefined | string): string | null {
+  return value === undefined ? null : (
+      createHash('sha256').update(value).digest('hex')
+    )
+}
