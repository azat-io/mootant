diff --git a/core/cache/create-snapshot-session.ts b/core/cache/create-snapshot-session.ts
new file mode 100644
index 0000000..bb0bc6f
--- /dev/null
+++ b/core/cache/create-snapshot-session.ts
@@ -0,0 +1,37 @@
+import type { AdapterSession } from '../../types/adapter/adapter-session'
+import type { DrySnapshot } from '../../types/cache/dry-snapshot'
+
+import { DryReuseMiss } from './dry-reuse-miss'
+
+/**
+ * Stands in for the session of the test runner in a run that replays a dry
+ * run snapshot: it lists the test files and tells the cache inputs, version,
+ * workers and warnings of the session that saved it, and refuses to run
+ * anything, so a run that would need the test runner starts over with it
+ * (`DryReuseMiss`).
+ *
+ * @param snapshot - Snapshot of an earlier run that still holds.
+ * @returns Session without a test runner.
+ */
+export function createSnapshotSession(snapshot: DrySnapshot): AdapterSession {
+  let { session } = snapshot
+  /**
+   * Refuses a run of the test runner.
+   *
+   * @returns Never resolves.
+   */
+  function refuse(): Promise<never> {
+    return Promise.reject(new DryReuseMiss('a mutant needs the test runner'))
+  }
+  return {
+    listTestFiles: () => Promise.resolve([...snapshot.testFiles]),
+    cacheInputs: () => Promise.resolve(session.inputs),
+    ...(session.version !== null && { version: session.version }),
+    ...(session.workers !== null && { workers: session.workers }),
+    diagnostics: session.diagnostics,
+    close: () => Promise.resolve(),
+    runIsolated: refuse,
+    runBatch: refuse,
+    dryRun: refuse,
+  }
+}
diff --git a/core/cache/dry-reuse-miss.ts b/core/cache/dry-reuse-miss.ts
new file mode 100644
index 0000000..26bf868
--- /dev/null
+++ b/core/cache/dry-reuse-miss.ts
@@ -0,0 +1,17 @@
+/**
+ * Thrown inside a run that replays a dry run snapshot (`DrySnapshot`) as soon as
+ * it turns out the snapshot cannot decide the run: it is stale, or a mutant has
+ * no valid cached verdict and would need the test runner. The run then starts
+ * over with the test runner; nothing ran or was written before.
+ */
+export class DryReuseMiss extends Error {
+  /**
+   * Creates the error.
+   *
+   * @param reason - Why the snapshot cannot decide the run.
+   */
+  public constructor(reason: string) {
+    super(`The saved dry run cannot be reused: ${reason}.`)
+    this.name = 'DryReuseMiss'
+  }
+}
