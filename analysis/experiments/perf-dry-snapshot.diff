index 0000000..a5c63c7
--- /dev/null
+++ b/core/cache/check-dry-snapshot.ts
@@ -0,0 +1,47 @@
+import type { DrySnapshot } from '../../types/cache/dry-snapshot'
+
+import { listVariableHashes } from './list-variable-hashes'
+import { hashProjectTree } from './hash-project-tree'
+import { createDigest } from './create-digest'
+import { hashFiles } from './hash-files'
+
+/**
+ * Tells whether a dry run snapshot (`DrySnapshot`) still holds for a run,
+ * cheapest check first: the key of the run, the environment variables of the
+ * main process, the files the dry run and the cache depended on, then every
+ * file under the project root (`hashProjectTree`).
+ *
+ * @param snapshot - Snapshot of an earlier run.
+ * @param run - Key, root and environment of this run.
+ * @param run.key - Key of this run (`getDrySnapshotKey`).
+ * @param run.root - Project root.
+ * @param run.environment - Environment variables of the main process as the
+ *   run started, before a test runner could set any.
+ * @returns Null when the snapshot holds, else what changed.
+ */
+export async function checkDrySnapshot(
+  snapshot: DrySnapshot,
+  run: { environment: NodeJS.ProcessEnv; root: string; key: string },
+): Promise<string | null> {
+  if (snapshot.key !== run.key) {
+    return 'the mutants, settings or versions changed'
+  }
+  let variables = listVariableHashes(
+    snapshot.variables.map(([name]) => name),
+    run.environment,
+  )
+  if (createDigest(variables) !== createDigest(snapshot.variables)) {
+    return 'an environment variable changed'
+  }
+  let hashes = await hashFiles(snapshot.files.map(([file]) => file))
+  let changed = snapshot.files.find(
+    ([file, hash]) => (hashes.get(file) ?? null) !== hash,
+  )
+  if (changed !== undefined) {
+    return `${changed[0]} changed`
+  }
+  if ((await hashProjectTree(run.root)) !== snapshot.tree) {
+    return 'a file of the project was added, removed or changed'
+  }
+  return null
+}
