@@ -0,0 +1,48 @@
+import { readFile } from 'node:fs/promises'
+
+import type { DrySnapshot } from '../../types/cache/dry-snapshot'
+
+import { DRY_SNAPSHOT_VERSION } from './dry-snapshot-version'
+import { isRecord } from '../plugins/is-record'
+
+/**
+ * Reads the dry run snapshot of a project (`DrySnapshot`). A missing or
+ * unreadable file, invalid JSON, another version or a value without the parts
+ * of a snapshot gives none: a snapshot only ever makes a run faster.
+ *
+ * @param file - Absolute path of the snapshot file.
+ * @returns The snapshot, or null.
+ */
+export async function readDrySnapshot(
+  file: string,
+): Promise<DrySnapshot | null> {
+  let content: unknown
+  try {
+    content = JSON.parse(await readFile(file, 'utf8'))
+  } catch {
+    return null
+  }
+  return isSnapshot(content) ? content : null
+}
+
+/**
+ * Tells whether a value read from a snapshot file has the parts of a snapshot
+ * of this version; the parts themselves are trusted, as mootant wrote them.
+ *
+ * @param content - Parsed content of the file.
+ * @returns Whether it is a snapshot.
+ */
+function isSnapshot(content: unknown): content is DrySnapshot {
+  return (
+    isRecord(content) &&
+    content['version'] === DRY_SNAPSHOT_VERSION &&
+    typeof content['key'] === 'string' &&
+    typeof content['tree'] === 'string' &&
+    Array.isArray(content['files']) &&
+    Array.isArray(content['variables']) &&
+    Array.isArray(content['testFiles']) &&
+    isRecord(content['session']) &&
+    isRecord(content['phase']) &&
+    isRecord(content['phase']['dry'])
+  )
+}
