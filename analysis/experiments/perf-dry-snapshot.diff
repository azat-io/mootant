diff --git a/types/cache/dry-snapshot.d.ts b/types/cache/dry-snapshot.d.ts
new file mode 100644
index 0000000..de553b7
--- /dev/null
+++ b/types/cache/dry-snapshot.d.ts
@@ -0,0 +1,75 @@
+import type { DryRunResult } from '../adapter/dry-run-result'
+import type { CacheInputs } from '../adapter/cache-inputs'
+import type { Diagnostic } from '../mutant/diagnostic'
+
+/**
+ * What a run saw of its test runner up to and including the dry phase, saved
+ * next to the cache file so that a later run whose inputs are all unchanged can
+ * decide its mutants from cached verdicts without starting the test runner
+ * (prototype, `MOOTANT_REUSE_DRY_RUN`). Paths are absolute: the key includes
+ * the project root.
+ */
+export interface DrySnapshot {
+  /**
+   * Outcome of the dry phase: the final dry run, the keys of the unrepeatable
+   * test files, the messages of the files whose mutants get no verdict, by
+   * display path, and the diagnostics of the phase.
+   */
+  phase: {
+    unrepeatableFiles: string[]
+    errors: [string, string][]
+    diagnostics: Diagnostic[]
+    dry: DryRunResult
+  }
+
+  /**
+   * What the session reported besides its runs: its version, workers and
+   * warnings, and what verdicts depend on beyond each test file
+   * (`AdapterSession.cacheInputs`).
+   */
+  session: {
+    diagnostics: Diagnostic[]
+    version: string | null
+    workers: number | null
+    inputs: CacheInputs
+  }
+
+  /**
+   * Names of the environment variables that test files read or that change
+   * verdicts whatever reads them, with the hash of their value in the main
+   * process, or null when unset.
+   */
+  variables: [string, string | null][]
+
+  /**
+   * Absolute paths with the hash of their contents of the files the dry run
+   * and the cache depended on: the files of `session.inputs`, the lockfile,
+   * `package.json`, the root `tsconfig` and `.env` files and every dependency
+   * of every test file of the dry run, inside the root or not.
+   */
+  files: [string, string | null][]
+
+  /**
+   * Absolute paths of the test files and setup files of the session
+   * (`AdapterSession.listTestFiles`).
+   */
+  testFiles: string[]
+
+  /**
+   * Version of the format (`DRY_SNAPSHOT_VERSION`).
+   */
+  version: number
+
+  /**
+   * Hash of every file and its contents under the project root, but
+   * `node_modules`, `.git` and `.mootant` (`hashProjectTree`): a file added,
+   * removed or changed anywhere, such as a new test file or a helper of a test
+   * file the dry run did not run, makes the snapshot stale.
+   */
+  tree: string
+
+  /**
+   * Hash of what the dry run was asked to do (`getDrySnapshotKey`).
+   */
+  key: string
+}
