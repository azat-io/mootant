+import { writeFile, mkdtemp, symlink, mkdir, rm } from 'node:fs/promises'
+import { afterEach, describe, expect, it } from 'vitest'
+import { tmpdir } from 'node:os'
+import path from 'node:path'
+
+import { hashProjectTree } from '../../../core/cache/hash-project-tree'
+
+describe('hashProjectTree', () => {
+  let root = ''
+
+  afterEach(async () => {
+    await rm(root, { recursive: true, force: true })
+  })
+
+  it('changes with any file but those of skipped directories', async () => {
+    root = await mkdtemp(path.join(tmpdir(), 'mootant-tree-'))
+    await mkdir(path.join(root, 'src'))
+    await mkdir(path.join(root, 'node_modules', 'a'), { recursive: true })
+    await mkdir(path.join(root, '.git'))
+    await mkdir(path.join(root, '.mootant'))
+    await writeFile(path.join(root, 'src/a.ts'), 'a')
+    let first = await hashProjectTree(root)
+
+    await writeFile(path.join(root, 'node_modules/a/index.js'), 'x')
+    await writeFile(path.join(root, '.git/HEAD'), 'x')
+    await writeFile(path.join(root, '.mootant/report.html'), 'x')
+
+    await expect(hashProjectTree(root)).resolves.toBe(first)
+
+    await writeFile(path.join(root, 'src/a.ts'), 'b')
+    let changed = await hashProjectTree(root)
+
+    expect(changed).not.toBe(first)
+
+    await writeFile(path.join(root, 'src/b.ts'), '')
+    let added = await hashProjectTree(root)
+
+    expect(added).not.toBe(changed)
+
+    await symlink('src', path.join(root, 'link'))
+
+    await expect(hashProjectTree(root)).resolves.not.toBe(added)
+  })
+})
diff --git a/test/core/cache/list-variable-hashes.test.ts b/test/core/cache/list-variable-hashes.test.ts
new file mode 100644
index 0000000..799de72
--- /dev/null
+++ b/test/core/cache/list-variable-hashes.test.ts
@@ -0,0 +1,60 @@
+import { describe, expect, it } from 'vitest'
+import { createHash } from 'node:crypto'
+
+import { listVariableHashes } from '../../../core/cache/list-variable-hashes'
+
+/**
+ * Hashes a value as the snapshot does.
+ *
+ * @param value - Value of a variable.
+ * @returns SHA-256 in hex.
+ */
+function hash(value: string): string {
+  return createHash('sha256').update(value).digest('hex')
+}
+
+describe('listVariableHashes', () => {
+  it('hashes the names read and every variable that changes verdicts', () => {
+    expect(
+      listVariableHashes(['B', 'A'], {
+        LC_ALL: 'C',
+        OTHER: 'x',
+        TZ: 'UTC',
+        A: '1',
+      }),
+    ).toStrictEqual([
+      ['A', hash('1')],
+      ['B', null],
+      ['LC_ALL', hash('C')],
+      ['NODE_OPTIONS', null],
+      ['TZ', hash('UTC')],
+    ])
+  })
+
+  it('hashes every variable but the volatile ones under *', () => {
+    /**
+     * Reads the hash `*` stands for in an environment.
+     *
+     * @param environment - Environment variables.
+     * @returns Hash under `*`.
+     */
+    function star(environment: NodeJS.ProcessEnv): string | null {
+      let hashes = new Map(listVariableHashes(['*'], environment))
+      return hashes.get('*')!
+    }
+    let first = star({ OTHER: 'x', PWD: '/a' })
+
+    expect(star({ OTHER: 'x', PWD: '/b' })).toBe(first)
+    expect(star({ OTHER: 'y', PWD: '/a' })).not.toBe(first)
+    expect(star({ OTHER: 'x', PWD: '/a', NEW: '1' })).not.toBe(first)
+  })
+
+  it('reads the environment of the process by default', () => {
+    expect(listVariableHashes([])).toContainEqual([
+      'NODE_OPTIONS',
+      process.env['NODE_OPTIONS'] === undefined ? null : (
+        hash(process.env['NODE_OPTIONS'])
+      ),
+    ])
+  })
+})
