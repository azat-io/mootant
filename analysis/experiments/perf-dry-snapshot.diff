+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { writeFile, mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import path from 'node:path'
+
+import type { DrySnapshot } from '../../../types/cache/dry-snapshot'
+
+import { listVariableHashes } from '../../../core/cache/list-variable-hashes'
+import { checkDrySnapshot } from '../../../core/cache/check-dry-snapshot'
+import { hashProjectTree } from '../../../core/cache/hash-project-tree'
+import { hashFiles } from '../../../core/cache/hash-files'
+
+describe('checkDrySnapshot', () => {
+  let directories: string[] = []
+
+  afterEach(async () => {
+    vi.unstubAllEnvs()
+    await Promise.all(
+      directories.map(directory =>
+        rm(directory, { recursive: true, force: true }),
+      ),
+    )
+    directories = []
+  })
+
+  it('names the first input that changed, cheapest first', async () => {
+    let root = await mkdtemp(path.join(tmpdir(), 'mootant-snapshot-'))
+    let outside = await mkdtemp(path.join(tmpdir(), 'mootant-outside-'))
+    directories.push(root, outside)
+    let dependency = path.join(outside, 'lib.js')
+    await writeFile(dependency, 'one')
+    await writeFile(path.join(root, 'a.test.ts'), 'test')
+    vi.stubEnv('MOOTANT_SNAPSHOT_VARIABLE', 'a')
+    let hashes = await hashFiles([dependency])
+    let snapshot = {
+      variables: listVariableHashes(['MOOTANT_SNAPSHOT_VARIABLE']),
+      files: [[dependency, hashes.get(dependency)!]],
+      tree: await hashProjectTree(root),
+      key: 'key',
+    } as DrySnapshot
+
+    await expect(
+      checkDrySnapshot(snapshot, { environment: process.env, key: 'other', root }),
+    ).resolves.toBe('the mutants, settings or versions changed')
+    await expect(
+      checkDrySnapshot(snapshot, { environment: process.env, key: 'key', root }),
+    ).resolves.toBeNull()
+
+    vi.stubEnv('MOOTANT_SNAPSHOT_VARIABLE', 'b')
+
+    await expect(
+      checkDrySnapshot(snapshot, { environment: process.env, key: 'key', root }),
+    ).resolves.toBe('an environment variable changed')
+
+    vi.stubEnv('MOOTANT_SNAPSHOT_VARIABLE', 'a')
+    await writeFile(dependency, 'two')
+
+    await expect(
+      checkDrySnapshot(snapshot, { environment: process.env, key: 'key', root }),
+    ).resolves.toBe(`${dependency} changed`)
+
+    await writeFile(dependency, 'one')
+    await writeFile(path.join(root, 'b.test.ts'), 'test')
+
+    await expect(
+      checkDrySnapshot(snapshot, { environment: process.env, key: 'key', root }),
+    ).resolves.toBe('a file of the project was added, removed or changed')
+  })
+})
