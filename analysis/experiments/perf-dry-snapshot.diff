diff --git a/core/cache/get-dry-snapshot-key.ts b/core/cache/get-dry-snapshot-key.ts
new file mode 100644
index 0000000..a1fef68
--- /dev/null
+++ b/core/cache/get-dry-snapshot-key.ts
@@ -0,0 +1,66 @@
+import { createHash } from 'node:crypto'
+import { stat } from 'node:fs/promises'
+
+import type { ActiveMutator } from '../../types/mutator/active-mutator'
+import type { SwitchedFile } from '../../types/adapter/switched-file'
+import type { TestAdapter } from '../../types/adapter/test-adapter'
+import type { LimitSettings } from '../../types/run/run-state'
+
+import { INSTRUMENTER_VERSION } from '../instrument/instrumenter-version'
+import { DRY_SNAPSHOT_VERSION } from './dry-snapshot-version'
+import { RUNTIME_VERSION } from '../runtime/runtime-version'
+import { getPortablePath } from './get-portable-path'
+import { CACHE_VERSION } from './cache-version'
+import { createDigest } from './create-digest'
+import { version } from '../../package.json'
+
+/**
+ * Builds the key of a dry run snapshot (`DrySnapshot`) over what the dry run
+ * was asked to do and how the run reads it: the versions of mootant, its build,
+ * the snapshot format, the cache, the instrumenter and the runtime; the adapter;
+ * the version of Node.js with the platform; the project root; fast mode, which
+ * repeats every test; the try limits; the preset and its mutators; and the
+ * switched files with their texts, which name every hosted mutant.
+ *
+ * @param input - Settings, adapter and switched files of the run.
+ * @param input.setup - Preset, active mutators and preset settings.
+ * @param input.switched - Switched files the dry run would serve, in order.
+ * @param input.limits - How try limits grow from the dry run.
+ * @param input.adapter - Adapter of the run.
+ * @param input.fast - Whether the run is in fast mode.
+ * @param input.root - Project root.
+ * @returns SHA-256 in hex.
+ */
+export async function getDrySnapshotKey(input: {
+  setup: { mutators: ActiveMutator[]; settings: unknown; preset: string }
+  switched: readonly SwitchedFile[]
+  limits: LimitSettings
+  adapter: TestAdapter
+  fast: boolean
+  root: string
+}): Promise<string> {
+  let { setup, root } = input
+  return createDigest([
+    DRY_SNAPSHOT_VERSION,
+    CACHE_VERSION,
+    version,
+    (await stat(import.meta.filename)).mtimeMs,
+    INSTRUMENTER_VERSION,
+    RUNTIME_VERSION,
+    [input.adapter.name, input.adapter.version ?? null],
+    [process.version, process.platform, process.arch],
+    root,
+    input.fast,
+    input.limits,
+    [
+      setup.mutators.map(mutator => [mutator.id, mutator.options]),
+      setup.settings,
+      setup.preset,
+    ],
+    input.switched.map(file => [
+      getPortablePath(file.file, root),
+      createHash('sha256').update(file.switched).digest('hex'),
+      createHash('sha256').update(file.original).digest('hex'),
+    ]),
+  ])
+}
