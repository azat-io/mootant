diff --git a/core/cache/write-dry-snapshot.ts b/core/cache/write-dry-snapshot.ts
new file mode 100644
index 0000000..377b9d6
--- /dev/null
+++ b/core/cache/write-dry-snapshot.ts
@@ -0,0 +1,131 @@
+import { writeFile, rename, mkdir, rm } from 'node:fs/promises'
+import path from 'node:path'
+
+import type { AdapterSession } from '../../types/adapter/adapter-session'
+import type { DryRunResult } from '../../types/adapter/dry-run-result'
+import type { DrySnapshot } from '../../types/cache/dry-snapshot'
+import type { Diagnostic } from '../../types/mutant/diagnostic'
+import type { RunCache } from '../../types/cache/run-cache'
+
+import { DRY_SNAPSHOT_VERSION } from './dry-snapshot-version'
+import { listVariableHashes } from './list-variable-hashes'
+import { compareCodeUnits } from '../compare-code-units'
+import { hashProjectTree } from './hash-project-tree'
+import { hashFiles } from './hash-files'
+
+/**
+ * What a dry run snapshot is written from.
+ */
+interface SnapshotInput {
+  /**
+   * Outcome of the dry phase of the run.
+   */
+  phase: {
+    unrepeatableFiles: ReadonlySet<string>
+    errors: ReadonlyMap<string, string>
+    diagnostics: Diagnostic[]
+    dry: DryRunResult
+  }
+
+  /**
+   * Environment variables of the main process as the run started, before the
+   * test runner could set any, such as `NODE_ENV`.
+   */
+  environment: NodeJS.ProcessEnv
+
+  /**
+   * Live session of the run, before it closes.
+   */
+  session: AdapterSession
+
+  /**
+   * Test files and setup files of the session.
+   */
+  testFiles: string[]
+
+  /**
+   * Cache of the run after it was saved: the files its keys were built from,
+   * with the hashes they had after the dry run.
+   */
+  cache: RunCache
+
+  /**
+   * Absolute path of the snapshot file.
+   */
+  file: string
+
+  /**
+   * Project root.
+   */
+  root: string
+
+  /**
+   * Key of the run (`getDrySnapshotKey`).
+   */
+  key: string
+}
+
+/**
+ * Saves the dry run of a run, after its cache was saved, so that a later run
+ * whose inputs are all unchanged can skip the test runner (`DrySnapshot`). The
+ * files the keys were built from are hashed again; nothing is saved when one of
+ * them changed during the run, when a test file of the dry run cannot tell what
+ * it depended on, or when the adapter tells nothing for the cache. A test file
+ * that listed every environment variable makes the snapshot hold only while
+ * every variable but the volatile ones stays the same (`listVariableHashes`).
+ * The file is written to a temporary file and renamed, so a reader never sees
+ * half of it.
+ *
+ * @param input - Dry phase, cache, session and where to save.
+ * @returns Null when saved, else why nothing was saved.
+ */
+export async function writeDrySnapshot(
+  input: SnapshotInput,
+): Promise<string | null> {
+  let { session, phase, cache, root } = input
+  let { dry } = phase
+  if (dry.files.some(file => !Array.isArray(file.dependencies))) {
+    return 'a test file cannot tell what it depended on'
+  }
+  if (session.cacheInputs === undefined) {
+    return 'the adapter tells nothing for the cache'
+  }
+  let names = new Set(dry.files.flatMap(file => file.environment ?? []))
+  let paths = [...cache.hashes.keys()].toSorted(compareCodeUnits)
+  let hashes = await hashFiles(paths)
+  if (paths.some(file => hashes.get(file) !== cache.hashes.get(file))) {
+    return 'a file the tests depend on changed during the run'
+  }
+  let snapshot: DrySnapshot = {
+    phase: {
+      unrepeatableFiles: [...phase.unrepeatableFiles].toSorted(
+        compareCodeUnits,
+      ),
+      diagnostics: phase.diagnostics,
+      errors: [...phase.errors],
+      dry,
+    },
+    session: {
+      diagnostics: [...(session.diagnostics ?? [])],
+      inputs: await session.cacheInputs(),
+      version: session.version ?? null,
+      workers: session.workers ?? null,
+    },
+    files: paths.map(file => [file, hashes.get(file) ?? null]),
+    variables: listVariableHashes(names, input.environment),
+    tree: await hashProjectTree(root),
+    version: DRY_SNAPSHOT_VERSION,
+    testFiles: input.testFiles,
+    key: input.key,
+  }
+  let temporary = `${input.file}.${process.pid}.tmp`
+  try {
+    await mkdir(path.dirname(input.file), { recursive: true })
+    await writeFile(temporary, JSON.stringify(snapshot))
+    await rename(temporary, input.file)
+  } catch (error) {
+    await rm(temporary, { force: true })
+    return `the snapshot could not be written (${(error as Error).message})`
+  }
+  return null
+}
