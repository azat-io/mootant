@@ -0,0 +1,20 @@
+/**
+ * Name of the environment variable that turns the reuse of a dry run on in
+ * this prototype; a release would make it part of the cache.
+ */
+const VARIABLE = 'MOOTANT_REUSE_DRY_RUN'
+
+/**
+ * Tells whether a run saves its dry run for later runs and reuses the dry run
+ * of an earlier one when nothing changed (`DrySnapshot`): only when
+ * `MOOTANT_REUSE_DRY_RUN` is `1` or `true`.
+ *
+ * @param environment - Environment variables to read.
+ * @returns Whether the reuse is on.
+ */
+export function readReuseDryRun(
+  environment: NodeJS.ProcessEnv = process.env,
+): boolean {
+  let value = environment[VARIABLE]
+  return value === '1' || value === 'true'
+}
