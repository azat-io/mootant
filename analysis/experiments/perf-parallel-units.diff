new file mode 100644
index 0000000..d970018
--- /dev/null
+++ b/core/run/read-parallel-units.ts
@@ -0,0 +1,22 @@
+/**
+ * Name of the environment variable that turns on parallel units of one test
+ * file in this prototype; a release would read `run.parallelUnits` of the
+ * configuration instead.
+ */
+const VARIABLE = 'MOOTANT_PARALLEL_UNITS'
+
+/**
+ * Tells whether isolated units of one test file may run at the same time
+ * (`AdapterContext.parallelUnits`): only when `MOOTANT_PARALLEL_UNITS` is `1` or
+ * `true`. Off by default, since tests may rely on a test file never running
+ * twice at once, as with a fixed file, port or database.
+ *
+ * @param environment - Environment variables to read.
+ * @returns Whether parallel units are on.
+ */
+export function readParallelUnits(
+  environment: NodeJS.ProcessEnv = process.env,
+): boolean {
+  let value = environment[VARIABLE]
+  return value === '1' || value === 'true'
+}
