+
+/**
+ * What the experiment needs to bring skipped candidates back.
+ */
+interface UnskipInput {
+  duplicates: ReadonlyMap<MutantCandidate, MutantCandidate>
+  solitary: ReadonlyMap<MutantCandidate, MutantCandidate>
+  ids: ReadonlyMap<MutantCandidate, string>
+  unskipped: readonly UnskippedCandidate[]
+  kept: readonly MutantCandidate[]
+  mutants: Mutant[]
+  source: string
+  file: string
+}
+
+/**
+ * EXPERIMENT ONLY: adds the skipped candidates of the rules listed in
+ * MOOTANT_UNSKIP as extra mutants, each with an id of its own, and logs each to
+ * MOOTANT_UNSKIP_LOG with its rule and owner.
+ *
+ * @param input - Mutants of the file and the candidates that were skipped.
+ * @returns Mutants with the brought back ones, sorted by range.
+ */
+function addUnskippedMutants(input: UnskipInput): Mutant[] {
+  let { duplicates, solitary, mutants, source, kept, file, ids } = input
+  let listed = new Set(kept)
+  let extra: Mutant[] = []
+  let occurrences = new Map<string, number>()
+  let entries: UnskippedCandidate[] = [...input.unskipped]
+  for (let [candidate, inner] of solitary) {
+    if (isUnskipped('solitary')) {
+      entries.push({
+        by: {
+          id: listed.has(inner) ? ids.get(inner)! : null,
+          mutator: inner.registered.id,
+          start: inner.start,
+          end: inner.end,
+        },
+        note: { reason: 'solitary', rule: 'solitary', heuristic: true },
+        candidate,
+      })
+    }
+  }
+  for (let [candidate, first] of duplicates) {
+    if (isUnskipped('duplicate')) {
+      entries.push({
+        by: {
+          id: listed.has(first) ? ids.get(first)! : null,
+          mutator: first.registered.id,
+          start: first.start,
+          end: first.end,
+        },
+        note: { reason: 'duplicate', rule: 'duplicate', heuristic: false },
+        candidate,
+      })
+    }
+  }
+  let keptTexts = new Set(
+    kept.map(item => `${item.start}:${item.end}:${item.text}`),
+  )
+  for (let entry of entries) {
+    let { candidate } = entry
+    if (
+      candidate.text === source.slice(candidate.start, candidate.end) ||
+      keptTexts.has(`${candidate.start}:${candidate.end}:${candidate.text}`)
+    ) {
+      continue
+    }
+    let original = source.slice(candidate.start, candidate.end)
+    let scope = `unskip:${entry.note.rule}:${candidate.scope ?? ''}`
+    let key = JSON.stringify([
+      scope,
+      candidate.registered.id,
+      original,
+      candidate.text,
+    ])
+    let occurrence = occurrences.get(key) ?? 0
+    occurrences.set(key, occurrence + 1)
+    let id = createMutantId({
+      mutator: candidate.registered.id,
+      replacement: candidate.text,
+      path: file,
+      occurrence,
+      original,
+      scope,
+    })
+    extra.push(createMutant({ ...candidate, ignoreRule: null }, id, file))
+    logUnskipped({
+      heuristic: entry.note.heuristic === true,
+      mutator: candidate.registered.id,
+      replacement: candidate.text,
+      reason: entry.note.reason,
+      start: candidate.start,
+      rule: entry.note.rule,
+      end: candidate.end,
+      by: entry.by,
+      original,
+      file,
+      id,
+    })
+  }
+  return [...mutants, ...extra].toSorted(
+    (left, right) => left.start - right.start || right.end - left.end,
+  )
+}
diff --git a/core/generate/unskip.ts b/core/generate/unskip.ts
new file mode 100644
index 0000000..347ce1c
--- /dev/null
+++ b/core/generate/unskip.ts
@@ -0,0 +1,66 @@
+import { isMainThread } from 'node:worker_threads'
+import { appendFileSync } from 'node:fs'
+
+import type { MutantCandidate } from '../../types/mutant/mutant-candidate'
+import type { SkipNote } from '../../types/mutant/skip-note'
+
+import { skipRules } from '../skips/skip-rules'
+
+/**
+ * EXPERIMENT ONLY (analysis of false skips): a skipped candidate that is turned
+ * back into a mutant, with the note of the rule that skipped it.
+ */
+export interface UnskippedCandidate {
+  /**
+   * Candidate built from the skipped replacement.
+   */
+  candidate: MutantCandidate
+
+  /**
+   * Owner named by the rule, as offsets.
+   */
+  by: { mutator: string; start: number; end: number; id: string | null } | null
+
+  /**
+   * Rule and reason of the skip.
+   */
+  note: Pick<SkipNote, 'heuristic' | 'reason' | 'rule'>
+}
+
+/**
+ * Reads the rules to bring back from MOOTANT_UNSKIP: a comma-separated list of
+ * rule ids, or `all`.
+ *
+ * @param rule - Rule id.
+ * @returns Whether a skip of the rule becomes a mutant.
+ */
+export function isUnskipped(rule: string): boolean {
+  let value = process.env['MOOTANT_UNSKIP']
+  if (
+    !value ||
+    !isMainThread ||
+    process.env['MOOTANT_UNSKIP_PID'] !== String(process.pid)
+  ) {
+    return false
+  }
+  let entry = skipRules[rule as keyof typeof skipRules] as
+    | { category: string }
+    | undefined
+  if (!entry || entry.category === 'invalid') {
+    return false
+  }
+  let rules = new Set(value.split(','))
+  return rules.has('all') || rules.has(rule)
+}
+
+/**
+ * Appends one line about a brought back mutant to MOOTANT_UNSKIP_LOG.
+ *
+ * @param line - Data of the mutant.
+ */
+export function logUnskipped(line: Record<string, unknown>): void {
+  let path = process.env['MOOTANT_UNSKIP_LOG']
+  if (path) {
+    appendFileSync(path, `${JSON.stringify(line)}\n`)
+  }
+}
