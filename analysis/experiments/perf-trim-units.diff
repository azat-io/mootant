diff --git a/core/run/get-unit-trim.ts b/core/run/get-unit-trim.ts
new file mode 100644
index 0000000..5018b3a
--- /dev/null
+++ b/core/run/get-unit-trim.ts
@@ -0,0 +1,33 @@
+import type { IsolatedRequest, RunState } from '../../types/run/run-state'
+import type { UnitTrim } from '../../types/adapter/isolated-plan'
+
+import { getTestFileKey } from './get-test-file-key'
+
+/**
+ * Picks the tests an isolated unit is cut down to when the run trims units
+ * (`RunState.trimUnits`): the tests of the unit's file that reached its mutant
+ * in the dry run. A static mutant, reached while a test file loaded, keeps
+ * whole files, since any test may see what loading did; so does a file where
+ * no test reached the mutant.
+ *
+ * @param state - State of the run.
+ * @param request - Mutant and test file of the unit.
+ * @returns Trim of the unit, or null to run the whole file.
+ */
+export function getUnitTrim(
+  state: RunState,
+  request: IsolatedRequest,
+): UnitTrim | null {
+  let mode = state.trimUnits ?? null
+  if (mode === null) {
+    return null
+  }
+  let mutant = state.mutants.get(request.mutant)!
+  if (mutant.static) {
+    return null
+  }
+  let tests = mutant.coveredBy.filter(
+    id => getTestFileKey(state.analysis.tests.get(id)!) === request.file,
+  )
+  return tests.length === 0 ? null : { tests, mode }
+}
