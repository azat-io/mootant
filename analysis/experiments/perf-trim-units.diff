--- /dev/null
+++ b/adapters/vitest/worker/select-trimmed-tests.ts
@@ -0,0 +1,29 @@
+import type { RunnerTestCase } from 'vitest'
+
+import type { UnitTrim } from '../../../types/adapter/isolated-plan'
+
+/**
+ * Selects the tests a trimmed isolated unit runs (`UnitTrim`): every test up to
+ * the last covering test in file order with `prefix`, or only the covering
+ * tests with `covering`.
+ *
+ * @param tests - Collected tests of the file in file order.
+ * @param trim - Covering tests of the unit and the mode.
+ * @returns Ids of the tests to run, or null to run every test when no covering
+ *   test was collected, such as after the file changed.
+ */
+export function selectTrimmedTests(
+  tests: readonly RunnerTestCase[],
+  trim: UnitTrim,
+): Set<string> | null {
+  let covering = new Set(trim.tests)
+  let last = tests.findLastIndex(test => covering.has(test.id))
+  if (last === -1) {
+    return null
+  }
+  let selected =
+    trim.mode === 'prefix' ?
+      tests.slice(0, last + 1)
+    : tests.filter(test => covering.has(test.id))
+  return new Set(selected.map(test => test.id))
+}
