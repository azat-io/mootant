+import type { RunnerTestCase } from 'vitest'
+
+import { describe, expect, it } from 'vitest'
+
+import { selectTrimmedTests } from '../../../../adapters/vitest/worker/select-trimmed-tests'
+
+/**
+ * Creates fake collected tests with the given ids.
+ *
+ * @param ids - Ids in file order.
+ * @returns Fake tests that only have an id.
+ */
+function createTests(ids: string[]): RunnerTestCase[] {
+  return ids.map(id => ({ id }) as RunnerTestCase)
+}
+
+describe('selectTrimmedTests', () => {
+  let tests = createTests(['a', 'b', 'c', 'd', 'e'])
+
+  it('keeps every test up to the last covering one with prefix', () => {
+    expect(
+      selectTrimmedTests(tests, { tests: ['d', 'b'], mode: 'prefix' }),
+    ).toStrictEqual(new Set(['a', 'b', 'c', 'd']))
+  })
+
+  it('keeps only the covering tests with covering', () => {
+    expect(
+      selectTrimmedTests(tests, { tests: ['d', 'b'], mode: 'covering' }),
+    ).toStrictEqual(new Set(['b', 'd']))
+  })
+
+  it('runs every test when no covering test was collected', () => {
+    expect(
+      selectTrimmedTests(tests, { mode: 'prefix', tests: ['x'] }),
+    ).toBeNull()
+  })
+})
