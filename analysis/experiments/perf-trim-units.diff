--- /dev/null
+++ b/core/run/read-trim-units.ts
@@ -0,0 +1,22 @@
+import type { UnitTrim } from '../../types/adapter/isolated-plan'
+
+/**
+ * Name of the environment variable that turns on trimmed isolated units in this
+ * prototype; a release would read a setting of the configuration instead.
+ */
+const VARIABLE = 'MOOTANT_TRIM_UNITS'
+
+/**
+ * Reads how isolated units are cut down to the tests that reached their mutant
+ * (`UnitTrim`): `prefix` or `covering` from `MOOTANT_TRIM_UNITS`, anything else
+ * keeps whole test files.
+ *
+ * @param environment - Environment variables to read.
+ * @returns Mode of trimming, or null for whole test files.
+ */
+export function readTrimUnits(
+  environment: NodeJS.ProcessEnv = process.env,
+): UnitTrim['mode'] | null {
+  let value = environment[VARIABLE]
+  return value === 'prefix' || value === 'covering' ? value : null
+}
