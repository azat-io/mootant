+import { realpath, mkdtemp, rm } from 'node:fs/promises'
+import { afterEach, describe, expect, it } from 'vitest'
+import { tmpdir } from 'node:os'
+import path from 'node:path'
+
+import {
+  removeCacheProjects,
+  createCacheProject,
+  writeProjectFiles,
+  VITEST_CONFIG,
+  listVerdicts,
+  MATH_SOURCE,
+  runProject,
+} from './BUG-400-cache-project'
+
+/**
+ * Directories of shared fixtures created by the running test.
+ */
+let shared: string[] = []
+
+describe('BUG-403: files a test reads outside the project root', () => {
+  afterEach(async () => {
+    await removeCacheProjects()
+    await Promise.all(
+      shared.splice(0).map(directory =>
+        rm(directory, { recursive: true, force: true }),
+      ),
+    )
+  })
+
+  it('runs the mutants again when a fixture outside the root changes', async () => {
+    /*
+     * As in a monorepo whose packages read shared fixtures of the repository:
+     * the fixture lives outside the root of the mootant project.
+     */
+    let fixtures = await realpath(
+      await mkdtemp(path.join(tmpdir(), 'mootant-shared-')),
+    )
+    shared.push(fixtures)
+    let fixture = path.join(fixtures, 'limits.json')
+    await writeProjectFiles(fixtures, { 'limits.json': '{ "age": 30 }' })
+    let root = await createCacheProject({
+      'test/math.test.ts': [
+        "import { readFileSync } from 'node:fs'",
+        '',
+        "import { expect, it } from 'vitest'",
+        '',
+        "import { isAdult } from '../src/math'",
+        '',
+        `let limits = JSON.parse(readFileSync(${JSON.stringify(fixture)}, 'utf8'))`,
+        '',
+        "it('isAdult', () => {",
+        '  expect(isAdult(limits.age)).toBe(true)',
+        '  expect(isAdult(5)).toBe(false)',
+        '})',
+        '',
+      ].join('\n'),
+      'vitest.config.ts': VITEST_CONFIG,
+      'src/math.ts': MATH_SOURCE,
+    })
+    await runProject(root)
+    await writeProjectFiles(fixtures, { 'limits.json': '{ "age": 18 }' })
+
+    let cached = await runProject(root)
+    let fresh = await runProject(root, { cache: false })
+
+    /*
+     * `adapters/shared/track-inputs.ts` records only reads inside the root, so
+     * the fixture is in no key and the cached run keeps the verdicts of 30.
+     */
+    expect(listVerdicts(cached)).toStrictEqual(listVerdicts(fresh))
+  }, 120_000)
+})
