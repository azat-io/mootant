+import {
+  removeCacheProjects,
+  createCacheProject,
+  VITEST_CONFIG,
+  MATH_SOURCE,
+  countCached,
+  runProject,
+} from './BUG-400-cache-project'
+
+/**
+ * Test that kills `age == 18` and leaves `age > 18` and `age >= 17`.
+ */
+let mathTest = [
+  "import { expect, it } from 'vitest'",
+  '',
+  "import { isAdult } from '../src/math'",
+  '',
+  "it('isAdult', () => {",
+  '  expect(isAdult(30)).toBe(true)',
+  '  expect(isAdult(5)).toBe(false)',
+  '})',
+  '',
+].join('\n')
+
+describe('BUG-404: a modification time at or after the start of the run', () => {
+  afterEach(async () => {
+    await removeCacheProjects()
+  })
+
+  it('reuses verdicts, or says why not, when the configuration has a future modification time', async () => {
+    let root = await createCacheProject({
+      'vitest.config.ts': VITEST_CONFIG,
+      'test/math.test.ts': mathTest,
+      'src/math.ts': MATH_SOURCE,
+    })
+    /*
+     * The clock of the file system is ahead, as on a shared folder of a VM, on
+     * /mnt/c under WSL2 or after unpacking an archive made on such a machine.
+     * Nothing changes between the runs.
+     */
+    let future = new Date(Date.now() + 2 * 60 * 60 * 1000)
+    await utimes(path.join(root, 'vitest.config.ts'), future, future)
+    await runProject(root)
+
+    let second = await runProject(root)
+    let explained = second.diagnostics.some(
+      diagnostic => diagnostic.code === 'cache-skipped',
+    )
+
+    /*
+     * `prepareRunCache` sees `mtime >= start`, returns null and the run has no
+     * cache: `cache` is false, nothing is cached or reused, and no diagnostic
+     * tells why.
+     */
+    expect({ cached: countCached(second) > 0 || explained }).toStrictEqual({
+      cached: true,
+    })
+  }, 120_000)
+
+  it('reuses verdicts when a test writes package.json back unchanged', async () => {
+    let root = await createCacheProject({
+      'test/math.test.ts': mathTest.replace(
+        "it('isAdult', () => {",
+        [
+          "import { readFileSync, writeFileSync } from 'node:fs'",
+          '',
+          "it('isAdult', () => {",
+          "  let file = new URL('../package.json', import.meta.url)",
+          '  writeFileSync(file, readFileSync(file))',
+        ].join('\n'),
+      ),
+      'vitest.config.ts': VITEST_CONFIG,
+      'src/math.ts': MATH_SOURCE,
+    })
+    await runProject(root)
+
+    let second = await runProject(root)
+
+    expect(second.cache).toBe(true)
+    expect(countCached(second)).toBeGreaterThan(0)
+  }, 120_000)
+})
