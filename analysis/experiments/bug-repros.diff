index 0000000..d200a4c
--- /dev/null
+++ b/test/repros/BUG-100/run.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+# BUG-100: a dry-run failure that reached no mutant site drops every switched
+# file with a false `instrumentation-break`.
+#   collateral/ - src/env.js declares `const globalThis` (BUG-101): its switched
+#                 text throws at load; src/price.js is innocent but is dropped too.
+#   flaky/      - test/format.test.js fails to load on the first run only; no
+#                 file is broken, yet every file is dropped.
+# Fixture tests are stored as *.check.js so that the mootant suite does not
+# collect them; run.sh renames them to *.test.js in a temporary copy.
+# Usage: MOOTANT_TGZ=/path/to/mootant.tgz ./run.sh
+set -euo pipefail
