new file mode 100755
index 0000000..969aa45
--- /dev/null
+++ b/test/repros/BUG-407/run.sh
@@ -0,0 +1,66 @@
+#!/usr/bin/env bash
+# BUG-407: reinstalling the same mootant package drops every cached verdict.
+# The build stamp of the environment key is the modification time of
+# dist/core/cache/prepare-run-cache.js (core/cache/prepare-run-cache.ts:164),
+# and npm gives installed files the time of the install.
+#
+# Usage: run.sh [path to mootant-*.tgz]   (default: the 170ec52 build)
+# Exit code: 1 while the bug is present (the second run reuses nothing),
+# 0 once a reinstall keeps the verdicts.
+set -eu
+tgz=${1:-/home/user/artifacts/mootant-0.1.0-170ec52.tgz}
+work=$(mktemp -d "${TMPDIR:-/tmp}/mootant-bug-407-XXXXXX")
+trap 'rm -rf "$work"' EXIT
+cd "$work"
+cat >package.json <<'JSON'
+{ "name": "bug-407", "private": true, "type": "module", "scripts": { "test": "vitest run" } }
+JSON
+mkdir -p src test
+printf 'export function isAdult(age: number): boolean {\n  return age >= 18\n}\n' >src/math.ts
+cat >test/math.test.ts <<'TS'
+import { expect, it } from 'vitest'
+
+import { isAdult } from '../src/math'
+
+it('isAdult', () => {
+  expect(isAdult(30)).toBe(true)
+  expect(isAdult(5)).toBe(false)
+})
+TS
+# --legacy-peer-deps: npm 10 cannot resolve the peer set of vitest 5.0.5.
+npm i -D --legacy-peer-deps --no-audit --no-fund "$tgz" vitest@5.0.5 vite@8.3.5 >/dev/null
+
+count_cached() {
+  node -e 'let r = JSON.parse(require("fs").readFileSync(0, "utf8")); console.log(r.summary.totalCached ?? 0)'
+}
+
+npx mootant run src --json --all --verbose 2>/dev/null >first.json
+cp node_modules/.cache/mootant/run-v3.json saved-cache.json
+second=$(npx mootant run src --json --all --verbose 2>/dev/null | count_cached)
+echo "unchanged project, same install:        $second cached"
+
+# CI: rm -rf node_modules && npm ci, then the cache directory is restored.
+stamp=node_modules/mootant/dist/core/cache/prepare-run-cache.js
+before=$(stat -c %y "$stamp")
+touch -r "$stamp" stamp-reference
+rm -rf node_modules/mootant
+sleep 1
+npm i -D --legacy-peer-deps --no-audit --no-fund --offline "$tgz" >/dev/null
+after=$(stat -c %y "$stamp")
+cp saved-cache.json node_modules/.cache/mootant/run-v3.json
+third=$(npx mootant run src --json --all --verbose 2>/dev/null | count_cached)
+echo "same version reinstalled: $third cached"
+echo "  (mtime $before -> $after)"
+
+# The exact old time, nanoseconds included: a copy that keeps whole seconds
+# only (as some archives and copies do) would still change the key.
+touch -r stamp-reference "$stamp"
+cp saved-cache.json node_modules/.cache/mootant/run-v3.json
+fourth=$(npx mootant run src --json --all --verbose 2>/dev/null | count_cached)
+echo "same files, old mtime restored:         $fourth cached"
+
+if [ "$third" = 0 ] && [ "$second" != 0 ]; then
+  echo "BUG-407 reproduced: a reinstall of the same package drops the cache"
+  exit 1
+fi
+echo "BUG-407 not reproduced"
