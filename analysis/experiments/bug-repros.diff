index 0000000..1b99358
--- /dev/null
+++ b/test/repros/BUG-102.test.ts
@@ -0,0 +1,116 @@
+import { describe, expect, it } from 'vitest'
+
+import { createMootantPlugin } from '../../adapters/vitest/create-mootant-plugin'
+import { createVitestSessionState } from '../helpers/create-vitest-session-state'
+import { instrumentFile } from '../../core/instrument/instrument-file'
+import { generateMutants } from '../helpers/generate-mutants'
+
+/**
+ * Digits of base64 VLQ.
+ */
+const BASE64 =
+  'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
+
+/**
+ * Position in a text, both 0-based.
+ */
+interface Position {
+  column: number
+  line: number
+}
+
+/**
+ * Maps a generated position back through a source map, as Vite does to report a
+ * stack trace; a missing map means the transform kept every position.
+ *
+ * @param map - Source map with `mappings`, or null.
+ * @param generated - Generated position.
+ * @returns Original position of the segment that holds it.
+ */
+function trace(
+  map: { mappings: string } | null,
+  generated: Position,
+): Position {
+  if (map === null) {
+    return generated
+  }
+  let state: [number, number, number, number] = [0, 0, 0, 0]
+  let found: Position | null = null
+  for (let [line, text] of map.mappings.split(';').entries()) {
+    state[0] = 0
+    for (let segment of text.split(',')) {
+      if (segment === '') {
+        continue
+      }
+      let values: number[] = []
+      let value = 0
+      let shift = 0
+      for (let char of segment) {
+        let digit = BASE64.indexOf(char)
+        value += (digit & 31) << shift
+        if (digit & 32) {
+          shift += 5
+        } else {
+          values.push(value & 1 ? -(value >> 1) : value >> 1)
+          value = 0
+          shift = 0
+        }
+      }
+      for (let [index, delta] of values.slice(0, 4).entries()) {
+        state[index as 0 | 1 | 2 | 3] += delta
+      }
+      if (
+        values.length >= 4 &&
+        line === generated.line &&
+        state[0] <= generated.column
+      ) {
+        found = { column: state[3], line: state[2] }
+      }
+    }
+  }
+  return found ?? { column: -1, line: -1 }
+}
+
+/**
+ * Finds where the `new Error('here')` of the program first occurs in a text.
+ *
+ * @param text - Text to search.
+ * @returns 0-based line and column of its first character.
+ */
+function locate(text: string): Position {
+  let offset = text.indexOf("new Error('here')")
+  let before = text.slice(0, offset).split('\n')
+  return { column: before.at(-1)!.length, line: before.length - 1 }
+}
+
+describe('BUG-102: the switched text moves code without a source map', () => {
+  it('maps the code after a multi-line mutant back to its original line and column', () => {
+    let source = [
+      'export function levels() {',
+      '  return [',
+      '    debug(),',
+      '    info(),',
+      '  ]',
+      '}',
+      'export function where() {',
+      "  return new Error('here').stack",
+      '}',
+    ].join('\n')
+    let mutants = generateMutants(source, { preset: 'strict', file: 'a.js' })
+    let switched = instrumentFile({ file: 'a.js', mutants, source })
+    let context = {
+      files: [{ file: '/project/src/a.js', original: source, switched }],
+    } as never
+    let plugin = createMootantPlugin(context, createVitestSessionState())
+    let { handler } = plugin.transform as {
+      handler(
+        code: string,
+        id: string,
+      ): { map: { mappings: string } | null; code: string }
+    }
+    let result = handler(source, '/project/src/a.js')
+
+    expect(mutants.some(mutant => mutant.replacement.includes('\n'))).toBe(true)
+    expect(trace(result.map, locate(result.code))).toStrictEqual(locate(source))
+  })
+})
