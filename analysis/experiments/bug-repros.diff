index 0000000..06f6a2a
--- /dev/null
+++ b/test/repros/BUG-401.test.ts
@@ -0,0 +1,77 @@
+import { afterEach, describe, expect, it } from 'vitest'
+import { symlink, rm } from 'node:fs/promises'
+import path from 'node:path'
+
+import type { GitRepository } from '../helpers/create-git-repository'
+
+import { createGitRepository } from '../helpers/create-git-repository'
+import { readChangedLines } from '../../core/git/read-changed-lines'
+
+/**
+ * Repository of the running test.
+ */
+let repository: GitRepository | null = null
+
+/**
+ * Lines of a numbered file: `line 1` to `line <count>`.
+ *
+ * @param count - Number of lines.
+ * @param changes - Replaced lines by number.
+ * @returns Text with a final line break.
+ */
+function createLines(
+  count: number,
+  changes: Record<number, string> = {},
+): string {
+  return Array.from(
+    { length: count },
+    (_value, index) => `${changes[index + 1] ?? `line ${index + 1}`}\n`,
+  ).join('')
+}
+
+describe('BUG-401: --since with a changed link to a changed source file', () => {
+  afterEach(async () => {
+    await repository?.remove()
+    repository = null
+  })
+
+  it('keeps the changed lines of the target when a tracked link to it changes too', async () => {
+    repository = await createGitRepository()
+    let { write, root, git } = repository
+    await write('src/lines.ts', createLines(6))
+    await write('src/target.ts', createLines(6))
+    await symlink('target.ts', path.join(root, 'src/link.ts'))
+    git('add', '.')
+    git('commit', '--quiet', '-m', 'base')
+    await write('src/lines.ts', createLines(6, { 4: 'changed' }))
+    await rm(path.join(root, 'src/link.ts'))
+    await symlink('lines.ts', path.join(root, 'src/link.ts'))
+
+    let { files } = await readChangedLines(root, 'HEAD')
+    let lines = files.get(path.join(root, 'src/lines.ts'))
+
+    /*
+     * `git diff` lists `src/lines.ts` with line 4 and then `src/link.ts`, whose
+     * text (the link target) changed on line 1; both resolve to the real path
+     * of `src/lines.ts`, and the second entry replaces the first, so line 4 is
+     * lost and line 1, which did not change, is selected.
+     */
+    expect(lines === 'all' || lines?.has(4)).toBe(true)
+  })
+
+  it('keeps the changed lines of the target when a link to it is added', async () => {
+    repository = await createGitRepository()
+    let { write, root, git } = repository
+    await write('src/lines.ts', createLines(6))
+    git('add', '.')
+    git('commit', '--quiet', '-m', 'base')
+    await write('src/lines.ts', createLines(6, { 4: 'changed' }))
+    await symlink('lines.ts', path.join(root, 'src/shared.ts'))
+    git('add', 'src/shared.ts')
+
+    let { files } = await readChangedLines(root, 'HEAD')
+    let lines = files.get(path.join(root, 'src/lines.ts'))
+
+    expect(lines === 'all' || lines?.has(4)).toBe(true)
+  })
+})
diff --git a/test/repros/BUG-402.test.ts b/test/repros/BUG-402.test.ts
new file mode 100644
index 0000000..a711f45
--- /dev/null
+++ b/test/repros/BUG-402.test.ts
@@ -0,0 +1,153 @@
+import type { TestProject } from 'vitest/node'
+
+import { afterEach, describe, expect, it } from 'vitest'
+
+import {
+  removeCacheProjects,
+  createCacheProject,
+  writeProjectFiles,
+  listVerdicts,
+  MATH_SOURCE,
+  runProject,
+} from './BUG-400-cache-project'
+import { collectDependencies } from '../../adapters/vitest/collect-dependencies'
+
+/**
+ * Module of a simulated module graph.
+ */
+interface FakeNode {
+  importedModules: Set<FakeNode>
+  transformResult: unknown
+  file: string | null
+  id: string | null
+  url: string
+}
+
+/**
+ * Builds a module of a simulated module graph.
+ *
+ * @param id - Resolved id.
+ * @returns Transformed module without imports; a module whose id is not an
+ *   absolute path has no file, as a virtual module.
+ */
+function createNode(id: string): FakeNode {
+  return {
+    file: id.startsWith('/') ? id : null,
+    importedModules: new Set(),
+    transformResult: {},
+    url: `url:${id}`,
+    id,
+  }
+}
+
+/**
+ * Configuration with a plugin that loads `virtual:limits` from `limits.json`
+ * and watches that file, as plugins of messages, routes or icons do.
+ */
+let virtualConfig = [
+  "import { readFileSync } from 'node:fs'",
+  "import path from 'node:path'",
+  '',
+  "import { defineConfig } from 'vitest/config'",
+  '',
+  'export default defineConfig({',
+  '  plugins: [',
+  '    {',
+  "      name: 'limits',",
+  '      resolveId(id) {',
+  "        return id === 'virtual:limits' ? '\\0virtual:limits' : null",
+  '      },',
+  '      load(id) {',
+  "        if (id !== '\\0virtual:limits') {",
+  '          return null',
+  '        }',
+  "        let file = path.resolve(import.meta.dirname, 'limits.json')",
+  '        this.addWatchFile(file)',
+  "        return `export default ${readFileSync(file, 'utf8')}`",
+  '      },',
+  '    },',
+  '  ],',
+  "  test: { include: ['test/**/*.test.ts'] },",
+  '})',
+  '',
+].join('\n')
+
+/**
+ * Test of `isAdult` at the boundary the virtual module gives.
+ */
+let virtualTest = [
+  "import { expect, it } from 'vitest'",
+  "// @ts-expect-error virtual module",
+  "import limits from 'virtual:limits'",
+  '',
+  "import { isAdult } from '../src/math'",
+  '',
+  "it('isAdult', () => {",
+  '  expect(isAdult(limits.age)).toBe(true)',
+  '  expect(isAdult(5)).toBe(false)',
+  '})',
+  '',
+].join('\n')
+
+describe('BUG-402: files a plugin watches for a virtual module', () => {
+  afterEach(async () => {
+    await removeCacheProjects()
+  })
+
+  it('counts the files a virtual module imports in the module graph', async () => {
+    let test = createNode('/p/test/a.test.ts')
+    let virtual = createNode('\0virtual:limits')
+    /*
+     * A plugin that loads `virtual:limits` from `limits.json` and calls
+     * `this.addWatchFile()` makes Vite's import analysis add the file to the
+     * imports of the virtual module (vite/dist/node/chunks/node.js, the
+     * `pluginImports` of `vite:import-analysis`).
+     */
+    let watched = createNode('/p/limits.json')
+    virtual.importedModules.add(watched)
+    test.importedModules.add(virtual)
+    let known = new Map([
+      [virtual.id!, virtual],
+      [test.id!, test],
+    ])
+    let project = {
+      vite: {
+        environments: {
+          ssr: {
+            moduleGraph: { getModuleById: (id: string) => known.get(id) },
+            transformRequest: () => Promise.resolve({}),
+          },
+        },
+      },
+    } as unknown as TestProject
+
+    let dependencies = await collectDependencies({
+      reported: [test.id!, virtual.id!],
+      file: '/p/test/a.test.ts',
+      tsconfigs: new Map(),
+      project,
+    })
+
+    expect(dependencies).toContain('/p/limits.json')
+  })
+
+  it('runs the mutants again when the file behind a virtual module changes', async () => {
+    let root = await createCacheProject({
+      'vitest.config.ts': virtualConfig,
+      'test/math.test.ts': virtualTest,
+      'limits.json': '{ "age": 30 }',
+      'src/math.ts': MATH_SOURCE,
+    })
+    await runProject(root)
+    await writeProjectFiles(root, { 'limits.json': '{ "age": 18 }' })
+
+    let cached = await runProject(root)
+    let fresh = await runProject(root, { cache: false })
+
+    /*
+     * With 18, `age > 18` is killed and `age == 18` survives; the cached run
+     * still reports `age > 18` as survived and `age == 18` as killed.
+     */
+    expect(listVerdicts(cached)).toStrictEqual(listVerdicts(fresh))
+  }, 120_000)
+})
