+import { afterEach, describe, expect, it } from 'vitest'
+import { mkdtemp, writeFile, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import path from 'node:path'
+
+import { readNodeRuntime } from '../../adapters/node-test/read-node-runtime'
+
+/**
+ * `NODE_OPTIONS` of the test process before the test changed it.
+ */
+let originalOptions = process.env['NODE_OPTIONS']
+
+/**
+ * Directory of the preload that prints to stdout.
+ */
+let directory: string | null = null
+
+describe('BUG-510: node:test probe with a preload that prints', () => {
+  afterEach(async () => {
+    if (originalOptions === undefined) {
+      delete process.env['NODE_OPTIONS']
+    } else {
+      process.env['NODE_OPTIONS'] = originalOptions
+    }
+    if (directory !== null) {
+      await rm(directory, { recursive: true, force: true })
+      directory = null
+    }
+  })
+
+  it('reads the runtime when NODE_OPTIONS preloads a module that prints', async () => {
+    directory = await mkdtemp(path.join(tmpdir(), 'mootant-print-'))
+    let preload = path.join(directory, 'print.cjs')
+    // As `-r dotenv/config` of dotenv 17 prints "[dotenv@17…] injecting env"
+    await writeFile(preload, "console.log('[preload] hello')\n")
+    process.env['NODE_OPTIONS'] = `--require ${preload}`
+
+    /*
+     * `node -p PROBE` prints the preload's line before the JSON; `JSON.parse`
+     * of the whole stdout throws inside the `execFile` callback, so the
+     * promise never settles and the exception is uncaught: `mootant run`
+     * crashes with a stack trace instead of starting the session.
+     */
+    await expect(readNodeRuntime(process.execPath)).resolves.toMatchObject({
+      version: process.version,
+    })
+  })
+})
diff --git a/test/repros/BUG-900.test.ts b/test/repros/BUG-900.test.ts
new file mode 100644
index 0000000..853e448
--- /dev/null
+++ b/test/repros/BUG-900.test.ts
@@ -0,0 +1,111 @@
+import { describe, expect, it } from 'vitest'
+
+import type { IsolatedResult } from '../../types/adapter/isolated-result'
+import type { IsolatedPlan } from '../../types/adapter/isolated-plan'
+import type { FakeWorld } from '../helpers/create-fake-adapter'
+
+import { runIsolatedRounds } from '../../core/run/run-isolated-rounds'
+import { getFinalStatus } from '../../core/run/get-final-status'
+import { createTestRun } from '../helpers/create-test-run'
+
+/**
+ * Tests of the project: `a1` never reaches mutant `m`, `a2` reaches and kills
+ * it, both in `/t/a.test.ts`, the file named after the module and ranked first;
+ * `b1` in `/t/b.test.ts` reaches it and checks nothing.
+ */
+let tests: FakeWorld['tests'] = [
+  { file: '/t/a.test.ts', id: 'a1' },
+  {
+    kills: { m: 'expected 2 to be 5' },
+    file: '/t/a.test.ts',
+    covers: ['m'],
+    id: 'a2',
+  },
+  { file: '/t/b.test.ts', covers: ['m'], id: 'b1' },
+]
+
+/**
+ * Changes the first isolated run only: its unit of `/t/a.test.ts` ends as the
+ * worker leaves it after a transient problem that has nothing to do with the
+ * mutant, before any test reached it.
+ *
+ * @param change - What the unit reports instead.
+ * @returns Hook of the simulated project.
+ */
+function spoilFirstRun(
+  change: (
+    facts: IsolatedResult['units'][number],
+  ) => IsolatedResult['units'][number],
+): NonNullable<FakeWorld['onIsolated']> {
+  return (result: IsolatedResult, plan: IsolatedPlan, call: number) => {
+    if (call !== 1) {
+      return result
+    }
+    return {
+      units: result.units.map(facts =>
+        plan.units[facts.unit]!.file === '/t/a.test.ts' ? change(facts) : facts,
+      ),
+    }
+  }
+}
+
+/**
+ * Runs the isolated path of mutant `m` outside fast mode.
+ *
+ * @param onIsolated - Change of the first isolated run.
+ * @returns Final status of `m`.
+ */
+async function runMutant(
+  onIsolated: NonNullable<FakeWorld['onIsolated']>,
+): Promise<ReturnType<typeof getFinalStatus>> {
+  let { session, state } = await createTestRun(
+    { onIsolated, tests },
+    { mutants: ['m'], isolate: true },
+  )
+  await runIsolatedRounds(session, state)
+  return getFinalStatus(state.mutants.get('m')!)
+}
+
+describe('BUG-900: an isolated unit that never ran the tests that reach the mutant counts as a file done without evidence', () => {
+  it('does not make the mutant Survived after a test that did not reach it timed out and the worker skipped the rest of the file', async () => {
+    /**
+     * Vitest's runner abandons the unit after any timed-out try
+     * (`adapters/vitest/runner.ts:886-888`, `onBeforeRunTask` skips the rest),
+     * so `a2`, which would kill `m`, never runs.
+     */
+    let status = await runMutant(
+      spoilFirstRun(facts => ({
+        ...facts,
+        tests: [
+          {
+            ...facts.tests[0]!,
+            message: 'Test timed out in 1000ms.',
+            timedOut: true,
+            reached: false,
+            failed: true,
+          },
+        ],
+        reached: false,
+      })),
+    )
+
+    // A plain run of the tests kills `m` (a2 fails); the unit that skipped a2
+    // proves nothing, so `m` must not survive on the strength of b1 alone.
+    expect(status).not.toBe('Survived')
+    expect(status).not.toBe('NoCoverage')
+  })
+
+  it('does not make the mutant Survived after a suite hook that did not reach it failed and no test ran', async () => {
+    let status = await runMutant(
+      spoilFirstRun(facts => ({
+        ...facts,
+        hookError: 'listen EADDRINUSE: address already in use :::4000',
+        reached: false,
+        tests: [],
+      })),
+    )
+
+    expect(status).not.toBe('Survived')
+    expect(status).not.toBe('NoCoverage')
+  })
+})
diff --git a/test/repros/BUG-901.test.ts b/test/repros/BUG-901.test.ts
new file mode 100644
index 0000000..120862d
--- /dev/null
+++ b/test/repros/BUG-901.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, it } from 'vitest'
+
+import type { IsolatedResult } from '../../types/adapter/isolated-result'
+import type { MutantState } from '../../types/run/mutant-state'
+import type { FakeWorld } from '../helpers/create-fake-adapter'
+
+import { runIsolatedRounds } from '../../core/run/run-isolated-rounds'
+import { getFinalStatus } from '../../core/run/get-final-status'
+import { createTestRun } from '../helpers/create-test-run'
+
+/**
+ * Runs mutant `m` isolated outside fast mode in a test file whose first unit
+ * fails as `spoil` says, for a reason that has nothing to do with `m`: `c1`
+ * never reaches `m`; `c2` reaches it and checks nothing, so a plain run of the
+ * tests lets `m` survive.
+ *
+ * @param spoil - What the first unit reports instead of its facts.
+ * @returns State of `m` after the isolated rounds.
+ */
+async function runMutant(
+  spoil: (
+    facts: IsolatedResult['units'][number],
+  ) => IsolatedResult['units'][number],
+): Promise<MutantState> {
+  let world: FakeWorld = {
+    onIsolated: (result: IsolatedResult, _plan, call) =>
+      call === 1 ? { units: result.units.map(spoil) } : result,
+    tests: [
+      { file: '/t/c.test.ts', id: 'c1' },
+      { file: '/t/c.test.ts', covers: ['m'], id: 'c2' },
+    ],
+  }
+  let { session, state } = await createTestRun(world, {
+    mutants: ['m'],
+    isolate: true,
+  })
+  await runIsolatedRounds(session, state)
+  return state.mutants.get('m')!
+}
+
+describe('BUG-901: a unit that fails before the mutant is reached kills the mutant', () => {
+  it('does not kill a mutant whose only covering file lost its worker once, before any test reached the mutant', async () => {
+    /**
+     * The worker dies during `c1` (the OOM killer, a signal), as Vitest reports
+     * it: no end record, no tries, nothing reached
+     * (`adapters/vitest/build-isolated-facts.ts:32-44`).
+     */
+    let mutant = await runMutant(facts => ({
+      ...facts,
+      incomplete: 'crash',
+      reached: false,
+      tests: [],
+    }))
+
+    // A crash that nothing ties to the mutant decides nothing: the unit should
+    // run again, as a missing unit does, and then `m` survives.
+    expect(mutant.verdict?.cause).not.toBe('crash')
+    expect(getFinalStatus(mutant)).toBe('Survived')
+  })
+
+  it('does not kill a mutant that is not reached while loading when its test file failed to load once', async () => {
+    /**
+     * The test file connects to a service at the top level and fails once while
+     * the service restarts; `m` is not reached while loading, which the end
+     * record of the unit tells (`reached: false`).
+     */
+    let mutant = await runMutant(facts => ({
+      ...facts,
+      loadError: 'connect ECONNREFUSED 127.0.0.1:5432',
+      reached: false,
+      tests: [],
+    }))
+
+    expect(mutant.verdict?.cause).not.toBe('load-error')
+    expect(getFinalStatus(mutant)).toBe('Survived')
+  })
+})
