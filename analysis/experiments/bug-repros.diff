+#!/bin/bash
+# BUG-505: an interrupted run leaves its work directory (mootant-XXXXXX with
+# beat, claim, done, env, out, plan, worker) and Vitest's own temporary
+# directory in TMPDIR: createWorkDirectory's directory is removed only in a
+# finally block, which a signal never reaches. Ctrl+C is simulated by SIGINT to
+# the whole process group. Builds dist when it is missing. Exit 1 = reproduced.
+set -u
+HERE=$(cd "$(dirname "$0")" && pwd)
+REPO=$(cd "$HERE/../../.." && pwd)
+SIGNAL=${1:-INT}
+[ -f "$REPO/dist/cli/index.js" ] || (cd "$REPO" && pnpm run build >/dev/null)
+cd "$HERE"
+export TMPDIR=$(mktemp -d)
+setsid node "$REPO/bin/mootant.js" run src --no-cache </dev/null >/dev/null 2>&1 &
+MOOTANT=$!
+sleep 2
+kill -s "$SIGNAL" -- "-$MOOTANT"
+wait "$MOOTANT"; echo "mootant exit code: $?"
+sleep 1
+LEFT=$(ls -A "$TMPDIR")
+rm -rf "$TMPDIR"
+if [ -n "$LEFT" ]; then
+  echo "REPRODUCED: left in TMPDIR: $LEFT"
+  exit 1
+fi
+echo "ok: TMPDIR is empty"
