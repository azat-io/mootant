+#!/bin/bash
+# BUG-501: a mootant.config.cts that requires mootant fails on Node.js 22.18+
+# (22.x) with "request for './instrument/resolve-switched-text.js' is from a
+# module not been linked": mootant loads .cts with import(), and Node 22's
+# require(esm) from a CommonJS TypeScript module loaded by import() breaks on
+# an ES module with imports of its own; Node 24 and 26 load it, and so does
+# require() of the same file on Node 22. Builds dist when it is missing.
+# Exit 1 = reproduced.
+set -u
+HERE=$(cd "$(dirname "$0")" && pwd)
+REPO=$(cd "$HERE/../../.." && pwd)
+[ -f "$REPO/dist/cli/index.js" ] || (cd "$REPO" && pnpm run build >/dev/null)
+mkdir -p "$HERE/node_modules"
+ln -sfn "$REPO" "$HERE/node_modules/mootant"
+cd "$HERE"
+echo "node $(node --version)"
+node "$REPO/bin/mootant.js" list src </dev/null
+CODE=$?
+echo "--- the same file through require():"
+node -e "console.log(Object.keys(require('./mootant.config.cts')))"
+rm -rf "$HERE/node_modules"
+[ "$CODE" -eq 0 ] || { echo "REPRODUCED: exit $CODE"; exit 1; }
