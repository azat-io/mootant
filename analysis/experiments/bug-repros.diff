@@ -0,0 +1,40 @@
+import { describe, expect, it } from 'vitest'
+
+import { instrumentFile } from '../../core/instrument/instrument-file'
+import { runSwitchedProgram } from '../helpers/run-switched-program'
+import { generateMutants } from '../helpers/generate-mutants'
+import { applyMutant } from '../helpers/apply-mutant'
+import { runProgram } from '../helpers/run-program'
+
+describe('BUG-904: a local binding named globalThis hides every mutant site in its scope', () => {
+  it('switches the mutants of a function with a globalThis parameter like each mutant applied alone', async () => {
+    let file = 'example.js'
+    let source = [
+      'function f(globalThis, values) {',
+      '  let total = 0',
+      '  for (let value of values) {',
+      '    total = total + value * globalThis.scale',
+      '  }',
+      '  return total',
+      '}',
+    ].join('\n')
+    let inputs = [[{ scale: 2 }, [1, 2]]]
+    let mutants = generateMutants(source, { preset: 'recommended', file })
+    let switched = instrumentFile({ mutants, source, file })
+    let expected = await Promise.all(
+      mutants.map(mutant =>
+        runProgram(applyMutant(source, mutant), file, inputs),
+      ),
+    )
+    let actual = await Promise.all(
+      mutants.map(mutant =>
+        runSwitchedProgram({ active: mutant.id, switched, file }, inputs),
+      ),
+    )
+
+    // The site check `globalThis.__mootant?.hit(...)` reads the parameter, so
+    // no mutant is ever switched on and every one of them runs the original.
+    expect(mutants.length).toBeGreaterThan(0)
+    expect(actual).toStrictEqual(expected)
+  })
+})
