@@ -0,0 +1,95 @@
+import { afterEach, describe, expect, it } from 'vitest'
+
+import {
+  removeCacheProjects,
+  createCacheProject,
+  writeProjectFiles,
+  listVerdicts,
+  runProject,
+} from './BUG-400-cache-project'
+
+/**
+ * Referenced configuration of the package, with the option under test.
+ *
+ * @param define - Value of `useDefineForClassFields`.
+ * @returns Text of `packages/web/tsconfig.app.json`.
+ */
+function createAppConfig(define: boolean): string {
+  return JSON.stringify({
+    compilerOptions: { useDefineForClassFields: define, target: 'ES2022' },
+    include: ['src', 'test'],
+  })
+}
+
+describe('BUG-419: a tsconfig a package references', () => {
+  afterEach(async () => {
+    await removeCacheProjects()
+  })
+
+  it('runs the mutants again when a referenced tsconfig changes how classes compile', async () => {
+    let root = await createCacheProject({
+      'packages/web/src/math.ts': [
+        'export function double(value: number): number {',
+        '  return value * 2',
+        '}',
+        '',
+        'class Base {',
+        '  stored = 0',
+        '',
+        '  set value(value: number) {',
+        '    this.stored = double(value)',
+        '  }',
+        '',
+        '  get value(): number {',
+        '    return this.stored',
+        '  }',
+        '}',
+        '',
+        'export class Child extends Base {',
+        '  // @ts-expect-error a field over an accessor, as in older code bases',
+        '  value = 5',
+        '}',
+        '',
+      ].join('\n'),
+      'packages/web/test/math.test.ts': [
+        "import { expect, it } from 'vitest'",
+        '',
+        "import { Child, double } from '../src/math'",
+        '',
+        "it('child', () => {",
+        '  expect([5, 10]).toContain(new Child().value)',
+        '  expect(double(0)).toBe(0)',
+        '})',
+        '',
+      ].join('\n'),
+      'vitest.config.ts': [
+        "import { defineConfig } from 'vitest/config'",
+        '',
+        "export default defineConfig({ test: { include: ['packages/*/test/**/*.test.ts'] } })",
+        '',
+      ].join('\n'),
+      'packages/web/tsconfig.json': JSON.stringify({
+        references: [{ path: './tsconfig.app.json' }],
+        files: [],
+      }),
+      'packages/web/tsconfig.app.json': createAppConfig(true),
+    })
+    await runProject(root, { paths: ['packages/web/src'] })
+    /*
+     * With [[Set]] semantics the field calls the setter, so `double` runs and
+     * `value / 2` is killed; Vite reads the option from the referenced file,
+     * which `listTsconfigFiles` never lists.
+     */
+    await writeProjectFiles(root, {
+      'packages/web/tsconfig.app.json': createAppConfig(false),
+    })
+
+    let cached = await runProject(root, { paths: ['packages/web/src'] })
+    let fresh = await runProject(root, {
+      paths: ['packages/web/src'],
+      cache: false,
+    })
+
+    expect(listVerdicts(cached)).toStrictEqual(listVerdicts(fresh))
+  }, 120_000)
+})
