+import { afterEach, describe, expect, it } from 'vitest'
+import { rm } from 'node:fs/promises'
+import path from 'node:path'
+
+import { createBuiltIns } from '../helpers/create-built-ins'
+import { vitestAdapter } from '../../adapters/vitest/index'
+import { runMutants } from '../../core/run-mutants'
+
+/**
+ * Fixture project whose test caches the result of `compute` in `.cache/` of
+ * the project: the dry run computes and writes the cache, every isolated unit
+ * then reads it and never reaches the mutants of `compute`.
+ */
+let root = path.join(import.meta.dirname, '../fixtures/repros/BUG-206')
+
+describe('BUG-206: a mutant the dry run covered ends as NoCoverage when no unit reaches it', () => {
+  afterEach(async () => {
+    await rm(path.join(root, '.cache'), { recursive: true, force: true })
+  })
+
+  it('does not report a covered mutant as uncovered', { timeout: 300_000 }, async () => {
+    await rm(path.join(root, '.cache'), { recursive: true, force: true })
+    let result = await runMutants({
+      builtIns: createBuiltIns('vitest', vitestAdapter()),
+      concurrency: 2,
+      paths: ['src'],
+      cache: false,
+      cwd: root,
+    })
+    let contradictory = result.results.filter(
+      ({ coveredBy, status }) => status === 'NoCoverage' && coveredBy.length > 0,
+    )
+    // Actual: the mutants of `compute` (and the returned `result`) end as
+    // `NoCoverage` while their covering test is listed, with no diagnostic.
+    expect(contradictory.map(({ mutant }) => mutant.file)).toStrictEqual([])
+  })
+})
