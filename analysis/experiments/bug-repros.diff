+#!/bin/bash
+# BUG-509: with --json, stdout must hold only the report, but whatever code in
+# mootant's own process prints there (a Vitest config, a Vite plugin) comes
+# first, so JSON.parse of stdout fails. Builds dist when it is missing.
+# Exit 1 = reproduced.
+set -u
+HERE=$(cd "$(dirname "$0")" && pwd)
+REPO=$(cd "$HERE/../../.." && pwd)
+[ -f "$REPO/dist/cli/index.js" ] || (cd "$REPO" && pnpm run build >/dev/null)
+cd "$HERE"
+node "$REPO/bin/mootant.js" run src --json --no-cache </dev/null 2>/dev/null >report.json
+echo "mootant exit code: $?; first bytes of stdout: $(head -c 60 report.json)"
+if node -e 'JSON.parse(require("fs").readFileSync("report.json", "utf8"))' 2>/dev/null; then
+  rm -f report.json
+  echo "ok: stdout is JSON"
+  exit 0
+fi
+rm -f report.json
+echo "REPRODUCED: stdout of --json is not JSON"
+exit 1
