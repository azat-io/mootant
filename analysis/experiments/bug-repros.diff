+export function levels() {
+  return [
+    debug(),
+    info(),
+  ]
+}
+
+export function where() {
+  let line = new Error('here').stack.split('\n')[1]
+  return Number(line.match(/:(\d+):\d+\)?$/)[1])
+}
+
+export function level(index) {
+  return levels()[index]?.n ?? 0
+}
