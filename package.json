{
  "name": "mootant",
  "version": "0.1.0",
  "description": "Mutation testing tool that ships with an agent skill for finding and fixing weak tests",
  "keywords": [
    "mutation-testing",
    "mutation",
    "testing",
    "test-quality",
    "typescript",
    "javascript",
    "cli",
    "agent-skills",
    "ai-agents",
    "vitest",
    "jest",
    "node-test"
  ],
  "homepage": "https://github.com/azat-io/mootant",
  "repository": "azat-io/mootant",
  "license": "MIT",
  "author": "Azat S. <to@azat.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./jest": {
      "types": "./dist/adapters/jest/index.d.ts",
      "default": "./dist/adapters/jest/index.js"
    },
    "./node-test": {
      "types": "./dist/adapters/node-test/index.d.ts",
      "default": "./dist/adapters/node-test/index.js"
    },
    "./package.json": "./package.json",
    "./runtime": {
      "types": "./dist/core/runtime/index.d.ts",
      "default": "./dist/core/runtime/index.js"
    },
    "./vitest": {
      "types": "./dist/adapters/vitest/index.d.ts",
      "default": "./dist/adapters/vitest/index.js"
    }
  },
  "bin": {
    "mootant": "./bin/mootant.js"
  },
  "files": [
    "./bin",
    "./dist",
    "./skills"
  ],
  "scripts": {
    "build": "vite build",
    "ci:changelog": "changelogithub",
    "ci:clear": "clear-package-json package.json --output package.json",
    "docs:build": "astro build",
    "docs:dev": "astro dev",
    "docs:dev:astro": "astro dev",
    "release": "pnpm release:check && pnpm release:version && pnpm release:prepare && pnpm release:git",
    "release:check": "pnpm test && pnpm run build",
    "release:git": "pnpm release:git:add && pnpm release:git:commit && pnpm release:git:tag && pnpm release:git:push",
    "release:git:add": "git add .",
    "release:git:commit": "cross-env-shell \"git commit -m \\\"build: publish v$npm_package_version\\\"\"",
    "release:git:push": "cross-env-shell \"git push --atomic origin HEAD v$npm_package_version\"",
    "release:git:tag": "cross-env-shell \"git tag v$npm_package_version\"",
    "release:prepare": "pnpm run /^release:prepare:/",
    "release:prepare:changelog": "prettier --write changelog.md",
    "release:prepare:package-json": "prettier --write package.json",
    "release:version": "changelogen --output changelog.md --release --no-commit --no-tag",
    "test": "pnpm run /^test:/",
    "test:astro": "astro check",
    "test:css": "stylelint \"{cli,docs}/**/*.{astro,css}\"",
    "test:format": "prettier --check \"**/*.{astro,js,ts,json,md,mdx,yml}\"",
    "test:js": "eslint --concurrency auto .",
    "test:packages": "pnpm dedupe --check",
    "test:spelling": "cspell --config cspell.config.ts \"**/*\"",
    "test:types": "tsc --noEmit --pretty",
    "test:unit": "vitest --run --coverage",
    "test:usage": "knip"
  },
  "dependencies": {
    "@eslint-community/regexpp": "^4.12.3",
    "lilconfig": "^3.1.5",
    "oxc-parser": "^0.158.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.8",
    "@astrojs/mdx": "^8.1.5",
    "@astrojs/sitemap": "^3.7.4",
    "@azat-io/eslint-config": "^2.104.0",
    "@azat-io/prettier-config": "^1.4.0",
    "@azat-io/stylelint-config": "^2.0.0",
    "@azat-io/typescript-config": "^1.2.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@shikijs/transformers": "^4.6.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/compiler-dom": "^3.5.45",
    "astro": "^7.4.11",
    "browserslist": "^4.29.5",
    "changelogen": "^0.6.2",
    "changelogithub": "^15.0.5",
    "clean-publish": "^7.1.0",
    "cross-env": "^10.1.0",
    "cspell": "^10.4.1",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "hast-util-from-html": "^2.1.0",
    "jest": "^30.5.2",
    "jest-29": "npm:jest@^29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "jest-environment-jsdom-29": "npm:jest-environment-jsdom@^29.7.0",
    "jiti": "^2.7.0",
    "knip": "^6.45.1",
    "lightningcss": "^1.33.0",
    "minisearch": "^7.2.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.10.1",
    "rehype-external-links": "^3.0.0",
    "remark-sectionize": "^2.1.0",
    "shiki": "^4.6.0",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^18.0.0",
    "svelte": "^5.57.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  },
  "peerDependencies": {
    "@vue/compiler-dom": "^3.5.0",
    "jest": "^29.7.0 || ^30.0.0",
    "jiti": "^2.0.0",
    "svelte": "^5.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@vue/compiler-dom": {
      "optional": true
    },
    "jest": {
      "optional": true
    },
    "jiti": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
