---
import { getCollection } from 'astro:content'

import { getHeadings, frontmatter, Content } from '../../content/mutators.md'
import ContentLayout from '../../layouts/Content.astro'

interface Frontmatter {
  description: string
  keywords: string[]
  title: string
}

let { description, keywords, title } = frontmatter as Frontmatter

let mutators = (await getCollection('mutators')).toSorted(
  ({ data: { title: a } }, { data: { title: b } }) => a.localeCompare(b),
)
---

<ContentLayout
  editLink="https://github.com/azat-io/mootant/edit/main/docs/content/mutators.md"
  headings={getHeadings()}
  {description}
  {keywords}
  {title}
>
  <h1>{title}</h1>
  <p>
    A mutator makes one kind of change to your code, such as <code>+</code> to
    <code>-</code>. Each mutant in a report names the mutator that made it. The
    page of a mutator shows its changes, a test that catches them and the
    changes it skips.
  </p>
  <p>
    Mootant has 20 built-in mutators, and both
    <a href="/guide/configuration#presets">presets</a> turn all of them on.
    <code>strict</code> also turns on all mutator options, the mutants that may cause
    timeouts and the
    <a href="/guide/configuration#coarsemutants">coarse mutants</a> that
    <code>recommended</code> drops.
  </p>
  <table class="mutators">
    <thead>
      <tr>
        <th scope="col">Mutator</th>
        <th scope="col">Changes</th>
      </tr>
    </thead>
    <tbody>
      {
        mutators.map(({ data, id }) => (
          <tr>
            <th scope="row">
              <a href={`/mutators/${id}`}>{data.title}</a>
            </th>
            <td>
              {data.shortDescription}
              <span class="example">
                <code>{data.example.before}</code> →{' '}
                <code>{data.example.after}</code>
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <Content />
</ContentLayout>

<style>
  .mutators {
    margin-block: var(--space-l);

    & th[scope='row'] {
      font: inherit;
    }
  }

  .example {
    display: block;
    margin-block-start: var(--space-2xs);
  }
</style>
