---
import { HOW_IT_WORKS } from '../data/home'
import Typography from './Typography.astro'
import Container from './Container.astro'
---

<section
  class="how-it-works"
  id="how-it-works"
>
  <Container class="content">
    <Typography
      color="primary"
      class="title"
      align="start"
      size="2xl"
      tag="h2"
      bold
    >
      {HOW_IT_WORKS.title}
    </Typography>
    <ol class="steps">
      {HOW_IT_WORKS.steps.map(({ description, title, label }) => (
        <li class="step">
          <span class="label">{label}</span>
          <Typography
            color="primary"
            align="start"
            size="l"
            tag="h3"
            bold
          >
            {title}
          </Typography>
          <Typography
            align="start"
            size="s"
          >
            {description}
          </Typography>
        </li>
      ))}
    </ol>
  </Container>
</section>

<style>
  .how-it-works {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .content {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--space-xl);
  }

  .how-it-works .title {
    line-height: 1.2;
  }

  .steps {
    display: grid;
    gap: var(--space-xl);
    padding-inline-start: 0;
    margin-block: 0;
    list-style-type: '';

    @media (width >= 1024px) {
      grid-template-columns: repeat(3, [step] 1fr);
    }
  }

  .step {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--space-xs);
    padding-block-start: var(--space-m);
    margin-block: 0;
    border-block-start: 2px solid var(--color-border-secondary);

    &:last-child {
      border-block-start-color: var(--color-border-brand);
    }
  }

  .label {
    font: 600 var(--font-size-2xs) / 1.5 var(--font-family-code);
    color: var(--color-content-secondary);
  }
</style>
