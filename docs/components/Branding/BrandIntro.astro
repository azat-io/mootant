---
import Wordmark from '../Wordmark.astro'
---

<div class="intro">
  <span class="eyebrow">Mootant visual identity</span>
  <div
    aria-hidden="true"
    class="wordmark"
  >
    <Wordmark />
  </div>
  <p>A familiar face. One extra eye.</p>
</div>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    padding: var(--space-l) var(--space-xl);
    margin-block-start: var(--space-l);
    color: var(--color-content-primary);
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--border-radius-m);
  }

  .eyebrow {
    font: var(--font-size-xs) / 1.5 var(--font-family-code);
    color: var(--color-content-brand);
  }

  .wordmark {
    /* The eye's center uses the surface behind the artwork. */
    --color-background-primary: var(--color-background-secondary);
    padding-block: var(--space-m);

    & :global(svg) {
      display: block;
      inline-size: 100%;
      block-size: auto;
    }
  }

  p {
    margin-block: 0;
    font: var(--font-l);
    text-wrap: balance;
  }
</style>
