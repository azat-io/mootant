---
import { BRAND_COLORS } from '../../data/brand-colors'
---

<div class="palette">
  {BRAND_COLORS.map(({ description, oklch, name, hex }) => (
    <div class="color">
      <div
        style={{ background: hex }}
        aria-hidden="true"
        class="swatch"
      />
      <div class="details">
        <span class="name">{name}</span>
        <span class="description">{description}</span>
        {[
          { format: 'HEX', value: hex },
          { format: 'OKLCH', value: oklch },
        ].map(({ format, value }) => (
          <button
            aria-label={`Copy ${name} ${format}: ${value}`}
            data-color-value={value}
            class="copy-color"
            type="button"
          >
            <span class="format">
              <span>{format}</span>
              <span class="copy-label">Copy</span>
            </span>
            <span class="value">{value}</span>
          </button>
        ))}
      </div>
    </div>
  ))}
</div>
<output
  class="copy-status"
  aria-live="polite"
  data-color-status
></output>

<script>
  let resetTimers = new WeakMap<
    HTMLButtonElement,
    ReturnType<typeof setTimeout>
  >()

  document.addEventListener('click', async event => {
    if (!(event.target instanceof Element)) {
      return
    }
    let button = event.target.closest<HTMLButtonElement>('[data-color-value]')
    let value = button?.dataset['colorValue']
    let label = button?.querySelector('.copy-label')
    let status = document.querySelector('[data-color-status]')
    if (!button || !value || !label || !status) {
      return
    }
    try {
      await navigator.clipboard.writeText(value)
      label.textContent = 'Copied'
      status.textContent = `${value} copied to clipboard.`
      clearTimeout(resetTimers.get(button))
      resetTimers.set(
        button,
        setTimeout(() => {
          label.textContent = 'Copy'
        }, 2000),
      )
    } catch {
      status.textContent =
        'Could not copy. Select the color value to copy it manually.'
    }
  })
</script>

<style>
  .palette {
    display: grid;
    gap: var(--space-m);
    margin-block-start: var(--space-l);

    @container (inline-size >= 600px) {
      grid-template-columns: repeat(3, [color] minmax(0, 1fr));
    }
  }

  .color {
    overflow: hidden;
    border: 1px solid var(--color-border-primary);
    border-radius: var(--border-radius-m);
  }

  .swatch {
    block-size: 8rem;
    border-block-end: 1px solid var(--color-border-primary);
  }

  .details {
    display: flex;
    flex-direction: column;
    padding: var(--space-m);
  }

  .name {
    font: 600 var(--font-size-m) / 1.5 var(--font-family-base);
    color: var(--color-content-primary);
  }

  .description {
    margin-block: var(--space-2xs) var(--space-m);
    font: var(--font-xs);
  }

  .copy-color {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-xs) 0;
    font: var(--font-xs);
    color: var(--color-content-primary);
    text-align: start;
    cursor: pointer;
    background: none;
    border: none;
    border-block-start: 1px solid var(--color-border-primary);

    &:focus-visible {
      outline: 2px solid var(--color-border-brand);
      outline-offset: 3px;
    }

    @media (hover: hover) {
      &:hover .copy-label {
        color: var(--color-content-brand);
      }
    }
  }

  .format {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: space-between;
    color: var(--color-content-secondary);
  }

  .copy-label {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .value {
    font-family: var(--font-family-code);
    overflow-wrap: anywhere;
    user-select: text;
  }

  .copy-status {
    display: block;
    min-block-size: 1.65em;
    margin-block: var(--space-xs) 0;
    font: var(--font-xs);
    overflow-wrap: anywhere;
  }
</style>
