---
import { BRAND_TYPEFACES } from '../../data/brand-typefaces'
---

<div class="specimens">
  {BRAND_TYPEFACES.map(
    ({ className, alphabet, weights, sample, role, name, url }) => (
      <div class:list={['specimen', className]}>
        <div class="caption">
          <span>{role}</span>
          <a
            rel="noopener noreferrer"
            target="_blank"
            href={url}
          >
            {name}
          </a>
        </div>
        <p class="sample">
          {sample[0]}
          <br />
          {sample[1]}
        </p>
        <p class="alphabet">
          {alphabet[0]}
          <br />
          {alphabet[1]}
        </p>
        <span class="weights">{weights}</span>
      </div>
    ),
  )}
</div>

<style>
  .specimens {
    display: grid;
    margin-block: var(--space-l);
    overflow: hidden;
    border: 1px solid var(--color-border-primary);
    border-radius: var(--border-radius-m);

    @container (inline-size >= 600px) {
      grid-template-columns: repeat(2, [specimen] minmax(0, 1fr));
    }
  }

  .specimen {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    padding: var(--space-l);
  }

  .caption {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: start;
    font: var(--font-xs);

    & a {
      font-weight: 600;
      color: var(--color-content-primary);
    }
  }

  .sample {
    margin-block: auto 0;
    font: 600 var(--font-size-xl) / 1.4 var(--font-family-title);
    color: var(--color-content-primary);
  }

  .alphabet {
    margin-block: 0;
    font: var(--font-l);
  }

  .weights {
    font: var(--font-xs);
  }

  .mono {
    background: var(--color-background-secondary);
    border-block-start: 1px solid var(--color-border-primary);

    @container (inline-size >= 600px) {
      border-block-start: none;
      border-inline-start: 1px solid var(--color-border-primary);
    }

    & .sample {
      font-weight: normal;
      color: var(--color-content-brand);
    }

    & :is(.sample, .alphabet) {
      font-family: var(--font-family-code);
      font-variant-ligatures: none;
    }
  }
</style>
