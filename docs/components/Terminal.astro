---
import { Code } from 'astro:components'

import { colorTheme } from '../utils/shiki-theme'

interface Props {
  columns?: number
  class?: string
  output: string
}

let { class: className, columns = 63, output, ...props } = Astro.props
---

<div
  class:list={['terminal', className]}
  style={`--columns: ${columns}`}
  {...props}
>
  <Code
    theme={colorTheme}
    code={output}
    class="code"
    lang="ansi"
  />
</div>

<style>
  .terminal {
    container-type: inline-size;

    & :global(pre) {
      padding: var(--space-l) var(--space-m);
      border-radius: calc(var(--border-radius) * 1.5);
    }

    & :global(pre),
    & :global(code) {
      font-family: 'JetBrains Mono', monospace;
      font-size: clamp(
        0.75rem,
        (100cqi - 2 * var(--space-m)) / (var(--columns) * 0.6),
        var(--font-size-code)
      );
      line-height: 1.5;
    }
  }
</style>
