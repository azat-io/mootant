---
import { ClientRouter } from 'astro:transitions'

import Analytics from './Analytics.astro'
import '../styles/base.css'
import '../styles/fonts.css'
import '../styles/sizes.css'
import '../styles/colors.css'
import '../styles/spaces.css'

interface Props {
  type?: 'article' | 'website'
  description: string
  keywords?: string[]
  title?: string
}

/* The build uses format 'file', so the homepage pathname is '/index.html'. */
let canonicalPathname = Astro.url.pathname.replace(/\.html$/u, '')
if (canonicalPathname === '/index') {
  canonicalPathname = '/'
}
let canonicalURL = new URL(canonicalPathname, Astro.site)

let { type = 'website', description, keywords, title } = Astro.props
let websiteName = 'Mootant'

let pageTitle = title ? `${title} | ${websiteName}` : websiteName

let image = new URL(
  `${canonicalPathname === '/' ? '' : canonicalPathname}/open-graph.png`,
  Astro.site,
)
let author = 'Azat S.'

let isProduction = import.meta.env.PROD
---

<head>
  <meta charset="utf-8" />
  <meta
    content="width=device-width,initial-scale=1"
    name="viewport"
  />
  <meta
    content="light dark"
    name="color-scheme"
  />
  <meta
    name="theme-color"
    content="#f4f2ec"
  />

  <link
    media="(prefers-color-scheme: light)"
    href="/favicon-light.ico"
    sizes="any"
    rel="icon"
  />
  <link
    media="(prefers-color-scheme: dark)"
    href="/favicon-dark.ico"
    sizes="any"
    rel="icon"
  />
  <link
    media="(prefers-color-scheme: light)"
    href="/favicon-light.svg"
    type="image/svg+xml"
    rel="icon"
  />
  <link
    media="(prefers-color-scheme: dark)"
    href="/favicon-dark.svg"
    type="image/svg+xml"
    rel="icon"
  />
  <link
    href="/apple-touch-icon.png"
    rel="apple-touch-icon"
  />
  <link
    transition:persist="manifest"
    href="/manifest.webmanifest"
    rel="manifest"
  />

  <link
    href="/fonts/sora-regular.woff2"
    type="font/woff2"
    rel="preload"
    crossorigin
    as="font"
  />
  <link
    href="/fonts/sora-bold.woff2"
    type="font/woff2"
    rel="preload"
    crossorigin
    as="font"
  />
  <link
    href="/fonts/jetbrains-mono.woff2"
    type="font/woff2"
    rel="preload"
    crossorigin
    as="font"
  />

  <link
    href="/sitemap-index.xml"
    rel="sitemap"
  />
  <link
    href={canonicalURL}
    rel="canonical"
  />

  <title>{pageTitle}</title>
  <meta
    content={description}
    name="description"
  />
  <meta
    content={author}
    name="author"
  />

  <meta
    property="og:locale"
    content="en"
  />
  <meta
    property="og:type"
    content={type}
  />
  <meta
    content={canonicalURL}
    property="og:url"
  />
  <meta
    property="og:title"
    content={pageTitle}
  />
  <meta
    property="og:description"
    content={description}
  />
  <meta
    property="og:image"
    content={image}
  />
  <meta
    property="og:image:type"
    content="image/png"
  />
  <meta
    property="og:image:width"
    content="1200"
  />
  <meta
    property="og:image:height"
    content="630"
  />
  <meta
    content={`Cover for ${title ?? websiteName}`}
    property="og:image:alt"
  />

  {
    type === 'article' && (
      <>
        <meta
          property="article:author"
          content={author}
        />
        {keywords?.map(keyword => (
          <meta
            property="article:tag"
            content={keyword}
          />
        ))}
        <meta
          property="article:section"
          content="Technology"
        />
        <meta
          property="article:opinion"
          content="true"
        />
      </>
    )
  }

  <meta
    content="summary_large_image"
    name="twitter:card"
  />
  <meta
    content={canonicalURL}
    name="twitter:url"
  />
  <meta
    name="twitter:creator"
    content="@azat_io_en"
  />
  <meta
    name="twitter:title"
    content={pageTitle}
  />
  <meta
    name="twitter:description"
    content={description}
  />
  <meta
    name="twitter:image"
    content={image}
  />

  <script is:inline>
    let getTheme = () => {
      let stored = localStorage.getItem('theme')
      if (stored === 'light' || stored === 'dark') {
        return stored
      }
      return globalThis.matchMedia('(prefers-color-scheme: dark)').matches ?
          'dark'
        : 'light'
    }

    let getThemeColor = theme => (theme === 'dark' ? '#16171b' : '#f4f2ec')

    let applyTheme = (doc, theme) => {
      doc.documentElement.setAttribute('data-theme', theme)
      doc
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', getThemeColor(theme))
    }

    let theme = getTheme()
    applyTheme(document, theme)
    localStorage.setItem('theme', theme)

    let handlerKey = '__perfectionistThemeBeforeSwap__'
    if (!globalThis[handlerKey]) {
      document.addEventListener('astro:before-swap', event => {
        applyTheme(event.newDocument, getTheme())
      })

      new MutationObserver(() => {
        let currentTheme = document.documentElement.getAttribute('data-theme')
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', getThemeColor(currentTheme))
      }).observe(document.documentElement, {
        attributeFilter: ['data-theme'],
        attributes: true,
      })

      globalThis[handlerKey] = true
    }
  </script>

  <ClientRouter />

  {isProduction && <Analytics />}
</head>
