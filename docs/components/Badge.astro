---
import type { SvgComponent } from 'astro/types'

import Typography from './Typography.astro'

type Props =
  | {
      icon: SvgComponent
      title: string
      text: string
    }
  | {
      title?: never
      icon?: never
      text?: never
    }

let { icon: Icon, title, text } = Astro.props
---

{
  Icon ?
    <div class="card">
      <Icon
        aria-hidden="true"
        class="icon"
      />
      <div class="info">
        <Typography
          color="primary"
          class="line"
          size="m"
          bold
        >
          {title}
        </Typography>
        <Typography
          class="line"
          size="xs"
        >
          {text}
        </Typography>
      </div>
    </div>
  : <span class="badge">
      <slot />
    </span>
}

<style>
  .card {
    display: flex;
    flex-flow: row nowrap;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-s) var(--space-m);
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--border-radius);
  }

  .icon {
    flex-shrink: 0;
    inline-size: var(--size-icon-l);
    block-size: var(--size-icon-l);
    color: var(--color-content-primary);
  }

  .info {
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    gap: calc(var(--space-2xs) / 1.5);
    min-inline-size: 0;
  }

  .line {
    line-height: 1.4;
  }

  .badge {
    display: inline-block;
    padding: var(--space-2xs) var(--space-xs);
    font:
      600 var(--font-size-2xs) / 1 'JetBrains Mono',
      monospace;
    color: var(--color-content-primary);
    white-space: nowrap;
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border-primary);
    border-radius: calc(var(--border-radius) / 1.65);
  }
</style>
