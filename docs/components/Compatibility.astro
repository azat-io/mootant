---
import { COMPATIBILITY } from '../data/home'
import Typography from './Typography.astro'
import Container from './Container.astro'
import Button from './Button.astro'
import Badge from './Badge.astro'

let { extensions, runners, demo } = COMPATIBILITY
---

<section class="compatibility">
  <Container class="content">
    <div class="stack">
      <Typography
        color="primary"
        class="title"
        align="start"
        size="2xl"
        tag="h2"
        mbe="l"
        bold
      >
        {COMPATIBILITY.title}
      </Typography>
      <div class="groups">
        <div>
          <h3 class="label">File extensions</h3>
          <ul class="list extensions">
            {extensions.map(extension => (
              <li class="item">
                <Badge>{extension}</Badge>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="label">Test runners</h3>
          <ul class="list cards">
            {runners.map(({ title, icon, text }) => (
              <li class="item">
                <Badge
                  {title}
                  {icon}
                  {text}
                />
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
    <div class="demo">
      <Typography
        color="primary"
        class="title"
        align="start"
        size="2xl"
        tag="h2"
        mbe="l"
        bold
      >
        {demo.title}
      </Typography>
      <Typography
        align="start"
        size="m"
      >
        {demo.description}
      </Typography>
      <Typography
        align="start"
        size="m"
        mbe="l"
      >
        {demo.tip
          .split('`')
          .map((part, index) => (index % 2 === 1 ? <code>{part}</code> : part))}
      </Typography>
      <Button
        data-astro-prefetch="false"
        href="/report/demo"
        color="secondary"
        target="_blank"
        tag="a"
        full
      >
        View Demo
      </Button>
    </div>
  </Container>
</section>

<style>
  .compatibility {
    padding-block: var(--space-2xl);
  }

  .content {
    display: grid;
    gap: var(--space-xl) var(--space-l);

    @media (width >= 1280px) {
      grid-template-columns: repeat(3, [column] 1fr);
    }
  }

  .stack {
    display: flex;
    flex-flow: column nowrap;

    @media (width >= 1280px) {
      grid-column: span 2;
    }
  }

  .compatibility .title {
    line-height: 1.2;
  }

  .groups {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--space-l);
  }

  .label {
    margin-block: 0 var(--space-m);
    font: 600 0.75rem / 1.5 var(--font-family-code);
    color: var(--color-content-secondary);
  }

  .list {
    padding-inline-start: 0;
    margin-block: 0;
    list-style-type: '';
  }

  .extensions {
    display: flex;
    flex-flow: row wrap;
    gap: var(--space-xs);
  }

  .cards {
    display: grid;
    gap: var(--space-m);
    inline-size: fit-content;
    max-inline-size: 100%;

    @media (width >= 800px) {
      grid-auto-columns: 1fr;
      grid-auto-flow: column;
    }
  }

  .item {
    display: grid;
    margin-block: 0;
  }

  .demo {
    display: flex;
    flex-flow: column nowrap;
    align-items: start;
  }
</style>
