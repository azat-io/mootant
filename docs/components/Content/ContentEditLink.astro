---
import ContentFooterLink from './ContentFooterLink.astro'
import IconEdit from '../../icons/edit.svg'

interface Props {
  url: undefined | string
}

let { url } = Astro.props
---

{
  url && (
    <ContentFooterLink
      rel="noopener noreferrer"
      target="_blank"
      {url}
    >
      <IconEdit slot="icon" />
      Edit this page
    </ContentFooterLink>
  )
}
