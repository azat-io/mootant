---
import ContentFooterLink from './ContentFooterLink.astro'
import IconArrowRight from '../../icons/arrow-right.svg'
import IconArrowLeft from '../../icons/arrow-left.svg'
import { getPageUrl, pages } from '../../utils/pages'

let url = getPageUrl(Astro.url.pathname)
let links = pages.flatMap(({ links: sectionLinks, url: sectionUrl, title }) =>
  sectionUrl ? [{ url: sectionUrl, title }, ...sectionLinks] : sectionLinks,
)
let index = links.findIndex(link => link.url === url)
/* On the first page and on pages missing from the list, `index - 1` is
   negative and finds no page. */
let previousPage = links[index - 1]
let nextPage = index === -1 ? undefined : links[index + 1]
---

{
  (previousPage ?? nextPage) && (
    <nav
      aria-label="Docs pages"
      class="pages"
    >
      {previousPage && (
        <ContentFooterLink
          url={previousPage.url}
          class="page card-link"
          title="Previous page"
          rel="prev"
        >
          <IconArrowLeft slot="icon" />
          {previousPage.title}
        </ContentFooterLink>
      )}
      {nextPage && (
        <ContentFooterLink
          class="page card-link next"
          url={nextPage.url}
          title="Next page"
          rel="next"
        >
          <IconArrowRight slot="icon" />
          {nextPage.title}
        </ContentFooterLink>
      )}
    </nav>
  )
}

<style>
  .pages {
    display: grid;
    gap: var(--space-s);
    inline-size: 100%;

    @container (inline-size >= 600px) {
      grid-template-columns: repeat(2, [page] minmax(0, 1fr));
    }

    & .page {
      padding: var(--space-m);
    }

    & .next {
      grid-column: -2;

      @container (inline-size >= 600px) {
        flex-direction: row-reverse;
        text-align: end;
      }
    }
  }
</style>
