---
import { getPageUrl } from '../../utils/pages'

interface Props {
  title: string
  url: string
}

let { title, url } = Astro.props

let isActive = getPageUrl(Astro.url.pathname) === url
---

<a
  aria-current={isActive ? 'page' : undefined}
  class="nav-link link"
  href={url}
>
  {title}
</a>

<style>
  .link {
    display: block;
    padding: var(--space-2xs) var(--space-s);
    font: var(--font-xs);
  }
</style>
