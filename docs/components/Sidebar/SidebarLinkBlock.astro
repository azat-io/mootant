---
import SidebarLink from './SidebarLink.astro'
import Typography from '../Typography.astro'

interface Props {
  links: Link[]
  title: string
}

interface Link {
  title: string
  url: string
}

let { links, title } = Astro.props
---

<div>
  <Typography
    color="primary"
    class="title"
    size="s"
    tag="h2"
    bold
  >
    {title}
  </Typography>
  <ul class="links">
    {
      links.map(link => (
        <li class="item">
          <SidebarLink {...link} />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .title {
    padding: var(--space-2xs) var(--space-s);
  }

  .links {
    padding-inline-start: 0;
    margin-block: 0;
    list-style-type: '';
  }

  .item {
    margin-block: 0;
  }
</style>
