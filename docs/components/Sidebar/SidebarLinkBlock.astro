---
import { getPageUrl } from '../../utils/pages'
import SidebarLink from './SidebarLink.astro'
import Typography from '../Typography.astro'

interface Props {
  links: Link[]
  title: string
  url?: string
}

interface Link {
  title: string
  url: string
}

let { links, title, url } = Astro.props

let isActive = getPageUrl(Astro.url.pathname) === url
---

<div>
  <Typography
    color="primary"
    class="title"
    size="s"
    tag="h2"
    bold
  >
    {
      url ?
        <a
          aria-current={isActive ? 'page' : undefined}
          class="label link"
          href={url}
        >
          {title}
        </a>
      : <span class="label">{title}</span>
    }
  </Typography>
  <ul class="links">
    {
      links.map(link => (
        <li class="item">
          <SidebarLink {...link} />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .label {
    display: block;
    padding: var(--space-2xs) var(--space-s);
  }

  .link {
    color: inherit;
    text-decoration: none;

    @media (prefers-reduced-motion: no-preference) {
      transition:
        color 200ms,
        background 200ms;
    }

    @media (hover: hover) {
      &:hover {
        background: var(--color-background-primary-hover);
      }
    }

    &[aria-current='page'] {
      color: var(--color-content-brand);
    }
  }

  .links {
    padding-inline-start: 0;
    margin-block: 0;
    list-style-type: '';
  }

  .item {
    margin-block: 0;
  }
</style>
