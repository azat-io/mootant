---
import Typography from './Typography.astro'
import Container from './Container.astro'
import { WHY } from '../data/home'
import Lead from './Lead.astro'
---

<section class="why">
  <Container class="content">
    <div class="header">
      <Typography
        color="primary"
        class="title"
        align="start"
        size="2xl"
        tag="h2"
        mbe="m"
        bold
      >
        {WHY.title}
      </Typography>
      <Lead
        muted={WHY.lead.muted}
        quote
      >
        {WHY.lead.text}
      </Lead>
    </div>
    <ul class="cards">
      {WHY.cards.map(({ description, icon: Icon, title }) => (
        <li class="card">
          <div class="card-header">
            <Typography
              color="primary"
              align="start"
              size="l"
              tag="h3"
              bold
            >
              {title}
            </Typography>
            <Icon class="icon" />
          </div>
          <Typography
            align="start"
            size="s"
          >
            {description}
          </Typography>
        </li>
      ))}
    </ul>
  </Container>
</section>

<style>
  .why {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .content {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--space-xl);
  }

  .header {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--space-m);
    max-inline-size: 48rem;
  }

  .why .title {
    line-height: 1.2;
  }

  .cards {
    display: grid;
    gap: var(--space-l);
    padding-inline-start: 0;
    margin-block: 0;
    list-style-type: '';

    @media (width >= 768px) {
      grid-template-columns: repeat(2, [card] 1fr);
    }

    @media (width >= 1024px) {
      grid-template-columns: repeat(3, [card] 1fr);
    }
  }

  .card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--space-xs);
    padding: var(--space-l);
    margin-block: 0;
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--border-radius-m);
  }

  .card-header {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-s);
    align-items: center;
    justify-content: space-between;
  }

  .icon {
    flex-shrink: 0;
    inline-size: var(--size-icon-m);
    block-size: var(--size-icon-m);
    color: var(--color-content-primary);
  }
</style>
