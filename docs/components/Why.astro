---
import IconGitPullRequest from '../icons/git-pull-request.svg'
import IconFilter from '../icons/filter.svg'
import IconShield from '../icons/shield.svg'
import IconPuzzle from '../icons/puzzle.svg'
import Typography from './Typography.astro'
import Container from './Container.astro'
import IconHook from '../icons/hook.svg'
import IconBolt from '../icons/bolt.svg'
import Lead from './Lead.astro'

let cards = [
  {
    description:
      'Mootant skips equivalent, duplicate, and timeout-only mutations, so you spend less time investigating false alarms.',
    title: 'Less noise',
    icon: IconFilter,
  },
  {
    description:
      'Mootant mutates numbers, return values, and awaits-not just operators-to expose tests that miss changes in behavior.',
    title: 'Finds hidden gaps',
    icon: IconHook,
  },
  {
    description:
      "Mootant caches results and tracks their dependencies. Mutants unaffected by your changes don't need to run again.",
    title: 'Fast reruns',
    icon: IconBolt,
  },
  {
    description:
      'Test only the lines changed in a pull request, and fail CI when the mutation score falls below your threshold.',
    icon: IconGitPullRequest,
    title: 'Ready for CI',
  },
  {
    description:
      'Every survivor shows the code change and a suggested test file to improve. Uncovered mutants are reported separately.',
    title: 'Actionable reports',
    icon: IconShield,
  },
  {
    description:
      'Use your existing Vitest or node:test setup. JavaScript, TypeScript, Vue, and Svelte work out of the box.',
    title: 'Fits your stack',
    icon: IconPuzzle,
  },
]
---

<section class="why">
  <Container class="content">
    <div class="header">
      <Typography
        color="primary"
        class="title"
        align="start"
        size="2xl"
        tag="h2"
        mbe="m"
        bold
      >
        Why Mootant
      </Typography>
      <Lead
        muted="Mutation testing is often slow, noisy, and hard to act on."
        quote
      >
        Mootant was built to fix all three.
      </Lead>
    </div>
    <ul class="cards">
      {
        cards.map(({ description, icon: Icon, title }) => (
          <li class="card">
            <div class="card-header">
              <Typography
                color="primary"
                align="start"
                size="l"
                tag="h3"
                bold
              >
                {title}
              </Typography>
              <Icon class="icon" />
            </div>
            <Typography
              align="start"
              size="s"
            >
              {description}
            </Typography>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .why {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .content {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--space-xl);
  }

  .header {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--space-m);
    max-inline-size: 48rem;
  }

  .title {
    line-height: 1.2;
  }

  .cards {
    display: grid;
    gap: var(--space-l);
    padding-inline-start: 0;
    margin-block: 0;
    list-style-type: '';

    @media (width >= 768px) {
      grid-template-columns: repeat(2, [card] 1fr);
    }

    @media (width >= 1024px) {
      grid-template-columns: repeat(3, [card] 1fr);
    }
  }

  .card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--space-xs);
    padding: var(--space-l);
    margin-block: 0;
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border-primary);
    border-radius: calc(var(--border-radius) * 1.5);
  }

  .card-header {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-s);
    align-items: center;
    justify-content: space-between;
  }

  .icon {
    flex-shrink: 0;
    inline-size: var(--size-icon-m);
    block-size: var(--size-icon-m);
    color: var(--color-content-primary);
  }
</style>
